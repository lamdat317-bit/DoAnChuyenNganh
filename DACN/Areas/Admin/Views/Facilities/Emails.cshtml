@model List<DACN.Models.EmailMessage>
@{
    ViewData["Title"] = "Hộp thư hệ thống";
    var selected = ViewBag.Selected as DACN.Models.EmailMessage;
    bool smtp = ViewBag.SmtpConfigured == true;
}

<div class="page-header">
    <div class="container-xxl">
        <span class="eyebrow">Quản trị hệ thống</span>
        <h1>Hộp thư hệ thống</h1>
        <p class="sub">Email hệ thống đã gửi: đặt lại mật khẩu, xác nhận thanh toán, hoàn tiền, nhắc lịch chơi...</p>
        <partial name="_ManageNav" />
    </div>
</div>

<div class="container-xxl">
    @if (!smtp)
    {
        <div class="alert alert-warning small">
            <i class="bi bi-exclamation-triangle me-1"></i>Chưa cấu hình SMTP nên email <strong>chưa được gửi thật</strong>, chỉ lưu lại ở đây.
            Điền mục <span class="kbd-tag">"Smtp"</span> trong <span class="kbd-tag">appsettings.json</span> (vd Gmail: Host <em>smtp.gmail.com</em>, Port 587, User là địa chỉ Gmail, Password là <em>Mật khẩu ứng dụng</em>) rồi chạy lại để gửi email thật.
        </div>
    }
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="panel overflow-hidden">
                @if (!Model.Any())
                {
                    <div class="empty-state py-5"><span class="icon-bubble lg slate"><i class="bi bi-envelope"></i></span><p class="mb-0">Chưa có email nào.</p></div>
                }
                @foreach (var e in Model)
                {
                    <a asp-action="Emails" asp-route-id="@e.Id" class="notif-item border-bottom @(selected?.Id == e.Id ? "unread" : "")">
                        <span class="icon-bubble sm @(e.Sent ? "green" : "amber")"><i class="bi @(e.Sent ? "bi-send-check" : "bi-envelope-exclamation")"></i></span>
                        <span class="min-w-0 flex-grow-1">
                            <span class="d-flex justify-content-between gap-2"><span class="fw-semibold text-ink small text-truncate">@e.Subject</span><span class="text-muted text-nowrap" style="font-size:.72rem">@e.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span></span>
                            <span class="d-block text-muted small text-truncate">Tới: @e.To · @(e.Sent ? "Đã gửi" : "Chưa gửi")</span>
                        </span>
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-7">
            @if (selected != null)
            {
                <div class="panel">
                    <div class="panel-header d-block">
                        <div class="fw-bold text-ink">@selected.Subject</div>
                        <div class="small text-muted">Tới: @selected.To · @selected.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
                        @if (!string.IsNullOrEmpty(selected.Error))
                        {
                            <div class="small text-danger mt-1"><i class="bi bi-info-circle me-1"></i>@selected.Error</div>
                        }
                    </div>
                    <div class="panel-body">
                        @* Nội dung email do hệ thống tự tạo (đã mã hóa HTML dữ liệu người dùng), hiển thị trong iframe sandbox để không chạy script *@
                        <iframe sandbox="allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation" srcdoc="@selected.HtmlBody" title="Nội dung email" style="width:100%;height:460px;border:0;border-radius:8px;background:#fff"></iframe>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
