@model List<DACN.Models.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý người dùng";
    string? selectedRole = ViewBag.SelectedRole as string;
    var meId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    string Ini(string n) => string.Concat(n.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(w => char.ToUpper(w[0])));
}

<div class="page-header">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <span class="eyebrow">Quản trị hệ thống</span>
                <h1>Người dùng</h1>
                <p class="sub">Cấp tài khoản chủ sân, đổi vai trò, khóa hoặc xóa tài khoản.</p>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createManagerModal"><i class="bi bi-person-plus me-1"></i> Cấp tài khoản</button>
        </div>
        <partial name="_ManageNav" />
    </div>
</div>

<div class="container">
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card stat-card"><span class="icon-bubble blue"><i class="bi bi-people"></i></span><div><div class="label">Tổng tài khoản</div><div class="value">@ViewBag.TotalUsers</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card stat-card"><span class="icon-bubble green"><i class="bi bi-person-check"></i></span><div><div class="label">Khách hàng</div><div class="value">@ViewBag.TotalCustomers</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card stat-card"><span class="icon-bubble amber"><i class="bi bi-buildings"></i></span><div><div class="label">Chủ sân</div><div class="value">@ViewBag.TotalManagers</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card stat-card"><span class="icon-bubble red"><i class="bi bi-shield-lock"></i></span><div><div class="label">Quản trị viên</div><div class="value">@ViewBag.TotalAdmins</div></div></div></div>
    </div>

    <form method="get" asp-action="Index" class="filter-bar mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small">Tìm kiếm</label>
                <div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tên, email, số điện thoại" /></div>
            </div>
            <div class="col-md-4">
                <label class="form-label small">Vai trò</label>
                <select name="role" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Customer" selected="@(selectedRole == "Customer")">Khách hàng</option>
                    <option value="FacilityOwner" selected="@(selectedRole == "FacilityOwner")">Chủ sân</option>
                    <option value="Admin" selected="@(selectedRole == "Admin")">Quản trị viên</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Tìm</button>
                <a asp-action="Index" class="btn btn-light" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

