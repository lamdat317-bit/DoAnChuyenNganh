@model List<DACN.Models.ApplicationUser>
@{
    ViewData["Title"] = "Quản Trị Người Dùng & Cấp Quyền Quản Lý - SanBong.vn";
    string? selectedRole = ViewBag.SelectedRole as string;
}

<div class="container py-4">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="cyber-announcement mb-2 d-inline-flex">
                <span class="cyber-announcement-tag" style="background:#ef4444; color:#fff;">ADMIN PORTAL</span>
                <span class="cyber-announcement-text">Kênh Quản Trị Hệ Thống Trung Tâm</span>
            </div>
            <h2 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-danger"></i> Quản Trị Tài Khoản &amp; Cấp Quyền Quản Lý
            </h2>
            <p class="text-white-50 mb-0">Chỉ Quản Trị Viên (Admin) mới có quyền khởi tạo và phân quyền cho Chủ Sân / Quản Lý Cơ Sở</p>
        </div>
        <button type="button" class="btn btn-sport-gradient rounded-pill px-4 py-2 fw-bold text-white shadow-lg" data-bs-toggle="modal" data-bs-target="#createManagerModal">
            <i class="bi bi-person-plus-fill me-1"></i> + Cấp Tài Khoản Quản Lý Mới
        </button>
    </div>

    <!-- Navigation Pills for Admin -->
    <ul class="nav nav-pills mb-4 p-1 rounded-3" style="background: rgba(255, 255, 255, 0.05); max-width: 480px;">
        <li class="nav-item">
            <a class="nav-link active bg-primary text-white py-2 px-3 fw-bold small rounded-3" asp-area="Admin" asp-controller="User" asp-action="Index">
                <i class="bi bi-people me-1"></i> Quản Trị Người Dùng
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white-50 py-2 px-3 fw-bold small" asp-area="Admin" asp-controller="Bank" asp-action="Index">
                <i class="bi bi-bank2 me-1"></i> Ngân Hàng Ảo (Sổ Cái)
            </a>
        </li>
    </ul>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat Overview Cards (Cyber Glass) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-lg p-3 h-100 text-white" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #60a5fa;">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-white">@ViewBag.TotalUsers</h3>
                        <span class="text-white-50 small">Tổng số tài khoản</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-lg p-3 h-100 text-white" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #fbbf24;">
                        <i class="bi bi-building-gear fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-warning">@ViewBag.TotalManagers</h3>
                        <span class="text-white-50 small">Chủ sân / Quản lý cơ sở</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-lg p-3 h-100 text-white" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399;">
                        <i class="bi bi-person-check-fill fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-success">@ViewBag.TotalCustomers</h3>
                        <span class="text-white-50 small">Khách hàng (Người chơi)</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-lg p-3 h-100 text-white" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-danger">@ViewBag.TotalAdmins</h3>
                        <span class="text-white-50 small">Quản trị viên (Admin)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card shadow-lg border-0 mb-4" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: rgba(255,255,255,0.15);"><i class="bi bi-search text-info"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 text-white" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15);" placeholder="Tìm theo tên, email, số điện thoại..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: rgba(255,255,255,0.15);"><i class="bi bi-funnel text-warning"></i></span>
                        <select name="role" class="form-select border-start-0 text-white" style="background: #0f172a; border-color: rgba(255,255,255,0.15);">
                            <option value="" style="background: #0f172a;">-- Tất cả vai trò --</option>
                            <option value="FacilityOwner" selected="@(selectedRole == "FacilityOwner" ? "selected" : null)" style="background: #0f172a;">Chủ Sân / Quản Lý Cơ Sở</option>
                            <option value="Customer" selected="@(selectedRole == "Customer" ? "selected" : null)" style="background: #0f172a;">Khách Hàng (Người chơi)</option>
                            <option value="Admin" selected="@(selectedRole == "Admin" ? "selected" : null)" style="background: #0f172a;">Quản Trị Viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sport-gradient btn-sm w-100 fw-bold rounded-pill text-white">
                        <i class="bi bi-search me-1"></i> Tìm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-circle px-2" title="Làm mới">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow-lg border-0 mb-4" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px; overflow: hidden;">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-table me-2 text-info"></i> Danh sách tài khoản trong hệ thống (@Model.Count)</span>
            <small class="text-white-50"><i class="bi bi-shield-check text-success me-1"></i> Xác thực Identity bảo mật</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 align-middle" style="min-width: 900px;">
                    <thead class="table-secondary">
                        <tr>
                            <th class="ps-3 py-3">Họ và tên</th>
                            <th>Email đăng nhập</th>
                            <th>Số điện thoại</th>
                            <th class="text-center">Vai trò hệ thống</th>
                            <th class="text-center">Ngày tạo</th>
                            <th class="text-center pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-white-50">
                                    <i class="bi bi-inbox display-4 d-block mb-2 text-white-50"></i>
                                    Không tìm thấy tài khoản nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                        @foreach (var user in Model)
                        {
                            <tr style="background: #0f172a; border-bottom: 1px solid rgba(255,255,255,0.06);">
                                <td class="ps-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center text-white fw-bold" style="width: 38px; height: 38px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);">
                                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@user.FullName</div>
                                            <small class="text-white-50" style="font-size: 0.75rem;">ID: @user.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-white">@user.Email</span>
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="bi bi-patch-check-fill text-success ms-1" title="Đã xác thực email"></i>
                                    }
                                </td>
                                <td>
                                    <span class="text-white-50">@(user.PhoneNumber ?? "Chưa cập nhật")</span>
                                </td>
                                <td class="text-center">
                                    @switch (user.Role)
                                    {
                                        case UserRole.Admin:
                                            <span class="badge py-1 px-3" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 20px;">
                                                <i class="bi bi-shield-lock-fill me-1"></i> Quản Trị Viên
                                            </span>
                                            break;
                                        case UserRole.FacilityOwner:
                                            <span class="badge py-1 px-3" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 20px;">
                                                <i class="bi bi-building-gear me-1"></i> Chủ Sân / Quản Lý
                                            </span>
                                            break;
                                        default:
                                            <span class="badge py-1 px-3" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); border-radius: 20px;">
                                                <i class="bi bi-person me-1"></i> Khách Hàng
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-center text-white-50 small">
                                    @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center pe-3">
                                    @if (user.Email != "admin@sanbong.vn")
                                    {
                                        <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản @user.FullName (@user.Email)?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill py-1 px-3" title="Xóa tài khoản này">
                                                <i class="bi bi-trash me-1"></i> Xóa
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary opacity-50">Hệ thống</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: CẤP TÀI KHOẢN QUẢN LÝ / CHỦ SÂN (DÀNH RIÊNG CHO ADMIN)             -->
<!-- ========================================================================= -->
<div class="modal fade" id="createManagerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-xl" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.15) !important; border-radius: 20px; overflow: hidden;">
            <div class="modal-header bg-dark text-white border-bottom border-secondary border-opacity-25 py-3">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-building-add text-warning"></i> Cấp Tài Khoản Quản Lý / Chủ Sân
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateManager" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 text-white">
                    <div class="alert alert-dark border border-secondary border-opacity-25 small text-white-50 mb-3" style="background: rgba(255,255,255,0.03);">
                        <i class="bi bi-info-circle-fill text-info me-1"></i> Tài khoản được cấp sẽ có quyền quản trị cơ sở cụm sân, xem ma trận lịch đặt, cấu hình bảng giá và thu tiền check-in.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-white">Họ và tên Quản Lý / Chủ Sân:</label>
                        <input type="text" name="FullName" class="form-control text-white" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);" placeholder="VD: Nguyễn Văn Chủ Sân" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-white">Email đăng nhập:</label>
                        <input type="email" name="Email" class="form-control text-white" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);" placeholder="owner@sanbong.vn" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-white">Số điện thoại liên hệ:</label>
                        <input type="tel" name="PhoneNumber" class="form-control text-white" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);" placeholder="0901234567" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-white">Mật khẩu khởi tạo ban đầu:</label>
                        <input type="password" name="Password" class="form-control text-white" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);" placeholder="Tối thiểu 6 ký tự (VD: Password@123)" required minlength="6" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-white">Vai trò cấp phát:</label>
                        <select name="Role" class="form-select text-white" style="background: #0f172a; border-color: rgba(255,255,255,0.15);">
                            <option value="@((int)UserRole.FacilityOwner)" selected style="background: #0f172a;">🏢 Chủ Sân / Quản Lý Cơ Sở Thể Thao (Khuyên dùng)</option>
                            <option value="@((int)UserRole.Admin)" style="background: #0f172a;">🛡️ Quản Trị Viên Hệ Thống (Toàn quyền Admin)</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer border-top border-secondary border-opacity-25 bg-dark">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-sport-gradient rounded-pill px-4 text-white fw-bold shadow">
                        <i class="bi bi-check2-circle me-1"></i> Xác Nhận Cấp Tài Khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

