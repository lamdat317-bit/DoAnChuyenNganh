@model List<DACN.Models.Booking>
@using DACN.Models.Enums
@{
    ViewData["Title"] = "Đơn đặt sân";
    var facilities = ViewBag.Facilities as List<DACN.Models.Facility> ?? new();
    int? selectedFacilityId = ViewBag.SelectedFacilityId as int?;
    string? selectedStatus = ViewBag.SelectedStatus as string;
    string? selectedDate = ViewBag.SelectedDate as string;
    string? keyword = ViewBag.Keyword as string;
    int currentPage = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int verifyCount = ViewBag.VerifyCount ?? 0;
    int refundCount = ViewBag.RefundCount ?? 0;
}

<div class="page-header">
    <div class="container">
        <span class="eyebrow">Kênh chủ sân</span>
        <h1>Đơn đặt sân</h1>
        <p class="sub">Theo dõi đơn, xác nhận thanh toán và xử lý hủy lịch.</p>
        <partial name="_ManageNav" />
    </div>
</div>

<div class="container">
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card stat-card"><span class="icon-bubble blue"><i class="bi bi-receipt"></i></span><div><div class="label">Số đơn (theo bộ lọc)</div><div class="value">@totalCount</div></div></div></div>
        <div class="col-md-4"><div class="card stat-card"><span class="icon-bubble green"><i class="bi bi-cash-stack"></i></span><div><div class="label">Đã thu</div><div class="value">@(((decimal)ViewBag.TotalAmount).ToString("N0"))<small class="fs-6">đ</small></div></div></div></div>
        <div class="col-md-4"><div class="card stat-card"><span class="icon-bubble amber"><i class="bi bi-hourglass-split"></i></span><div><div class="label">Chờ thu tiền</div><div class="value">@ViewBag.UnpaidCount</div></div></div></div>
    </div>

    @if (verifyCount > 0 || refundCount > 0)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (verifyCount > 0)
            {
                <a asp-action="Bookings" asp-route-status="verify" asp-route-facilityId="@selectedFacilityId" class="chip @(selectedStatus == "verify" ? "active" : "")"><i class="bi bi-shield-exclamation"></i> Cần xác nhận chuyển khoản <span class="count">@verifyCount</span></a>
            }
            @if (refundCount > 0)
            {
                <a asp-action="Refunds" asp-route-facilityId="@selectedFacilityId" class="chip"><i class="bi bi-arrow-counterclockwise"></i> Chờ hoàn tiền <span class="count">@refundCount</span></a>
            }
        </div>
    }

    <form method="get" asp-action="Bookings" class="filter-bar mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label small">Tìm kiếm</label>
                <input type="text" name="q" value="@keyword" class="form-control" placeholder="Mã đơn, tên, SĐT" />
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label small">Cụm sân</label>
                <select name="facilityId" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var fac in facilities)
                    {
                        <option value="@fac.Id" selected="@(fac.Id == selectedFacilityId)">@fac.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small">Ngày</label>
                <input type="date" name="date" value="@selectedDate" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Pending" selected="@(selectedStatus == "Pending")">Chờ xác nhận</option>
                    <option value="Confirmed" selected="@(selectedStatus == "Confirmed")">Đã xác nhận</option>
                    <option value="Completed" selected="@(selectedStatus == "Completed")">Đã hoàn thành</option>
                    <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Đã hủy</option>
                    <option value="verify" selected="@(selectedStatus == "verify")">Chờ xác nhận chuyển khoản</option>
                    <option value="refund" selected="@(selectedStatus == "refund")">Chờ hoàn tiền</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>Lọc</button>
                <a asp-action="Bookings" class="btn btn-light" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

