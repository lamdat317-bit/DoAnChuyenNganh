@model List<DACN.Models.Booking>
@using DACN.Models.Enums
@{
    ViewData["Title"] = "Quản lý đơn đặt sân - Kênh Chủ Sân";
    var facilities = ViewBag.Facilities as List<DACN.Models.Facility> ?? new List<DACN.Models.Facility>();
    int? selectedFacilityId = ViewBag.SelectedFacilityId as int?;
    string? selectedStatus = ViewBag.SelectedStatus as string;
    string? selectedDate = ViewBag.SelectedDate as string;
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách cụm sân
            </a>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i> Quản Lý Đơn Đặt Sân Của Cơ Sở
            </h2>
            <small class="text-muted">Theo dõi lịch đặt sân, xác nhận đơn hàng và cập nhật tình trạng thu tiền</small>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Bookings" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Cụm sân:</label>
                    <select name="facilityId" class="form-select form-select-sm">
                        <option value="">-- Tất cả cụm sân --</option>
                        @foreach (var fac in facilities)
                        {
                            <option value="@fac.Id" selected="@(fac.Id == selectedFacilityId ? "selected" : null)">
                                @fac.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Ngày thi đấu:</label>
                    <input type="date" name="date" value="@selectedDate" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Trạng thái:</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Pending" selected="@(selectedStatus == "Pending" ? "selected" : null)">Pending (Chờ duyệt)</option>
                        <option value="Confirmed" selected="@(selectedStatus == "Confirmed" ? "selected" : null)">Confirmed (Đã xác nhận)</option>
                        <option value="Cancelled" selected="@(selectedStatus == "Cancelled" ? "selected" : null)">Cancelled (Đã hủy)</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end gap-2 pt-4">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    <a asp-action="Bookings" class="btn btn-outline-secondary btn-sm" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                Danh Sách Đơn Đặt (<span class="text-primary">@Model.Count</span> đơn)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Sân con & Cụm sân</th>
                            <th>Ngày & Khung giờ</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy đơn đặt sân nào phù hợp với bộ lọc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var bk in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">
                                        <span class="badge bg-light text-dark border">#BK-@bk.Id</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@(bk.CustomerName ?? bk.Customer?.FullName ?? "Khách hàng")</div>
                                        <small class="text-muted"><i class="bi bi-telephone me-1"></i>@(bk.CustomerPhone ?? bk.Customer?.PhoneNumber ?? "Chưa có SĐT")</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-success">@bk.Court?.Name</div>
                                        <small class="text-muted">@bk.Court?.Facility?.Name</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@bk.BookingDate.ToString("dd/MM/yyyy")</div>
                                        <span class="badge bg-light text-primary border">
                                            @bk.StartTime.ToString(@"hh\:mm") - @bk.EndTime.ToString(@"hh\:mm")
                                        </span>
                                    </td>
                                    <td class="fw-bold text-danger">
                                        @bk.TotalAmount.ToString("N0") đ
                                    </td>
                                    <td>
                                        @if (bk.PaymentStatus == PaymentStatus.Paid)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Chưa thanh toán</span>
                                        }
                                        @if (!string.IsNullOrEmpty(bk.PaymentProofImage))
                                        {
                                            <div class="mt-1">
                                                <button type="button" class="btn btn-sm btn-outline-info py-0 px-2 rounded-pill" style="font-size: 0.72rem;" onclick="viewProofModal('@bk.PaymentProofImage', '#BK-@bk.Id')">
                                                    <i class="bi bi-image me-1"></i> Minh chứng
                                                </button>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (bk.Status == BookingStatus.Confirmed)
                                        {
                                            <span class="badge bg-primary">Confirmed</span>
                                        }
                                        else if (bk.Status == BookingStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            @if (bk.PaymentStatus == PaymentStatus.Unpaid && bk.Status != BookingStatus.Cancelled)
                                            {
                                                <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@bk.Id" />
                                                    <input type="hidden" name="status" value="@BookingStatus.Confirmed" />
                                                    <input type="hidden" name="paymentStatus" value="@PaymentStatus.Paid" />
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Xác nhận đã thu tiền & duyệt sân">
                                                        <i class="bi bi-check-lg"></i> Thu tiền
                                                    </button>
                                                </form>
                                            }

                                            @if (bk.Status == BookingStatus.Pending)
                                            {
                                                <form asp-action="UpdateBookingStatus" method="post" class="d-inline ms-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@bk.Id" />
                                                    <input type="hidden" name="status" value="@BookingStatus.Confirmed" />
                                                    <button type="submit" class="btn btn-outline-primary btn-sm" title="Duyệt đơn giữ chỗ">
                                                        <i class="bi bi-hand-thumbs-up"></i> Duyệt
                                                    </button>
                                                </form>
                                            }

                                            @if (bk.Status != BookingStatus.Cancelled)
                                            {
                                                <form asp-action="UpdateBookingStatus" method="post" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc muốn hủy đơn đặt sân này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@bk.Id" />
                                                    <input type="hidden" name="status" value="@BookingStatus.Cancelled" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Hủy đơn">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }

                                            <a asp-area="" asp-controller="Booking" asp-action="Confirmation" asp-route-bookingId="@bk.Id" target="_blank" class="btn btn-outline-secondary btn-sm ms-1" title="Xem vé điện tử">
                                                <i class="bi bi-ticket-perforated"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal xem ảnh minh chứng -->
<div class="modal fade" id="modalProofView" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important;">
            <div class="modal-header border-bottom border-secondary border-opacity-25 text-white">
                <h5 class="modal-title fw-bold" id="modalProofTitle">Ảnh minh chứng chuyển khoản</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <img id="modalProofImg" src="" alt="Minh chứng" class="img-fluid rounded-3 shadow-lg" style="max-height: 550px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewProofModal(url, title) {
            document.getElementById('modalProofImg').src = url;
            document.getElementById('modalProofTitle').textContent = 'Minh chứng chuyển khoản ' + title;
            new bootstrap.Modal(document.getElementById('modalProofView')).show();
        }
    </script>
}

