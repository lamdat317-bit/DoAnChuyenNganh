        @if (totalPages > 1)
        {
            <div class="panel-body border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="small text-muted">Trang @currentPage / @totalPages · @totalCount đơn</span>
                <nav aria-label="Phân trang">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Bookings" asp-route-facilityId="@selectedFacilityId" asp-route-status="@selectedStatus" asp-route-date="@selectedDate" asp-route-q="@keyword" asp-route-page="@(currentPage - 1)">‹</a>
                        </li>
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Bookings" asp-route-facilityId="@selectedFacilityId" asp-route-status="@selectedStatus" asp-route-date="@selectedDate" asp-route-q="@keyword" asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Bookings" asp-route-facilityId="@selectedFacilityId" asp-route-status="@selectedStatus" asp-route-date="@selectedDate" asp-route-q="@keyword" asp-route-page="@(currentPage + 1)">›</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalProofView" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Biên lai <span id="modalProofTitle"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body text-center"><img id="modalProofImg" src="" alt="Biên lai" class="img-fluid rounded-3" style="max-height: 70vh;" /></div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="UpdateBookingStatus" method="post">
                <input type="hidden" name="bookingId" id="cancelBookingId" />
                <input type="hidden" name="status" value="@BookingStatus.Cancelled" />
                <div class="modal-body p-4 text-center">
                    <span class="icon-bubble lg red mb-3"><i class="bi bi-x-circle"></i></span>
                    <h5 class="fw-bold">Hủy đơn <span id="cancelBookingCode"></span>?</h5>
                    <p class="small text-muted mb-0">Khung giờ sẽ được mở lại cho khách khác đặt. Khách sẽ nhận được thông báo.</p>
                    <div class="alert alert-warning small text-start mt-3 mb-0 d-none" id="cancelRefundNote">Khách đã thanh toán: đơn sẽ chuyển sang mục <strong>Hoàn tiền</strong> với số tiền <strong id="cancelRefundAmt"></strong>.</div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Không</button>
                    <button type="submit" class="btn btn-danger">Hủy đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectProofModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="VerifyPayment" method="post">
                <input type="hidden" name="bookingId" id="rejectBookingId" />
                <input type="hidden" name="approve" value="false" />
                <div class="modal-body p-4">
                    <div class="text-center">
                        <span class="icon-bubble lg red mb-3"><i class="bi bi-x-octagon"></i></span>
                        <h5 class="fw-bold">Từ chối biên lai <span id="rejectBookingCode"></span>?</h5>
                        <p class="small text-muted">Đơn sẽ bị hủy và khung giờ được mở lại. Khách nhận được thông báo kèm lý do.</p>
                    </div>
                    <label class="form-label small" for="rejectReason">Lý do</label>
                    <input type="text" name="reason" id="rejectReason" class="form-control" maxlength="200" value="Không nhận được tiền chuyển khoản tương ứng" />
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Quay lại</button>
                    <button type="submit" class="btn btn-danger">Từ chối &amp; hủy đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalProofView').addEventListener('show.bs.modal', function (e) {
            document.getElementById('modalProofImg').src = e.relatedTarget.dataset.src;
            document.getElementById('modalProofTitle').textContent = e.relatedTarget.dataset.title;
        });
        document.getElementById('cancelBookingModal').addEventListener('show.bs.modal', function (e) {
            document.getElementById('cancelBookingId').value = e.relatedTarget.dataset.id;
            document.getElementById('cancelBookingCode').textContent = '#BK-' + e.relatedTarget.dataset.id;
            document.getElementById('cancelRefundNote').classList.toggle('d-none', e.relatedTarget.dataset.paid !== '1');
            document.getElementById('cancelRefundAmt').textContent = e.relatedTarget.dataset.amount + 'đ';
        });
        document.getElementById('rejectProofModal').addEventListener('show.bs.modal', function (e) {
            document.getElementById('rejectBookingId').value = e.relatedTarget.dataset.id;
            document.getElementById('rejectBookingCode').textContent = '#BK-' + e.relatedTarget.dataset.id;
        });
    </script>
}
