@model DACN.Models.Facility
@{
    ViewData["Title"] = $"Dịch vụ & Tiện ích - {Model.Name}";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách cụm sân
        </a>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-cup-hot text-primary me-2"></i> Dịch Vụ & Tiện Ích Sân Bãi
        </h2>
        <p class="text-muted">Cụm sân: <strong>@Model.Name</strong> | @Model.Address</p>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add New Service Form -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-plus-circle me-2"></i> Thêm Dịch Vụ / Tiện Ích Mới
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddService" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="facilityId" value="@Model.Id" />

                <div class="col-md-5">
                    <label class="form-label fw-bold">Tên dịch vụ / phụ kiện</label>
                    <input type="text" name="name" class="form-control" placeholder="VD: Nước khoáng Lavie 500ml, Thuê áo pitch, Thuê vợt..." required />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Đơn giá (VNĐ)</label>
                    <input type="number" name="price" step="1000" min="0" class="form-control" placeholder="VD: 10000" required />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Đơn vị tính</label>
                    <input type="text" name="unit" class="form-control" placeholder="Chai / Lần / Bộ" value="Lần" required />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100 fw-bold">
                        <i class="bi bi-plus-lg me-1"></i> Thêm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Existing Services Table -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-check text-success me-2"></i> Bảng Dịch Vụ Hiện Có Tại Cơ Sở
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên dịch vụ / Tiện ích</th>
                            <th>Đơn giá</th>
                            <th>Đơn vị tính</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Services.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Chưa có dịch vụ tiện ích nào được tạo cho cụm sân này. Hãy thêm dịch vụ ở form phía trên!
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var s in Model.Services)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        <i class="bi bi-tag-fill text-primary me-2"></i> @s.Name
                                    </td>
                                    <td class="text-danger fw-bold fs-6">
                                        @s.Price.ToString("N0") VNĐ
                                    </td>
                                    <td class="text-muted">@s.Unit</td>
                                    <td>
                                        <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                            @(s.IsActive ? "Đang áp dụng" : "Tạm ngưng")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="DeleteService" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa dịch vụ này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="serviceId" value="@s.Id" />
                                            <input type="hidden" name="facilityId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

