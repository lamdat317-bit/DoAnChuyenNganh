@model DACN.Models.Court
@{
    ViewData["Title"] = $"Bảng giá khung giờ - {Model.Name}";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2"><i class="bi bi-arrow-left me-1"></i> Quay lại danh sách cụm sân</a>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-clock-history text-primary me-2"></i> Thiết lập khung giờ & Bảng giá</h2>
        <p class="text-muted">Cụm sân: <strong>@Model.Facility?.Name</strong> | Sân con: <strong class="text-success">@Model.Name</strong></p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add New TimeSlot Form -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2"></i> Thêm khung giờ & Giá tiền mới</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddTimeSlot" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courtId" value="@Model.Id" />

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Giờ bắt đầu</label>
                    <input type="time" name="startTime" class="form-control" required value="06:00" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Giờ kết thúc</label>
                    <input type="time" name="endTime" class="form-control" required value="17:00" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Đơn giá (VNĐ/giờ)</label>
                    <input type="number" name="price" step="5000" min="0" class="form-control" required value="180000" />
                </div>
                <div class="col-md-3">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="isPeakHour" id="isPeakCheck" value="true">
                        <label class="form-check-label fw-semibold" for="isPeakCheck">
                            Giờ cao điểm
                        </label>
                    </div>
                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-lg me-1"></i> Lưu cấu hình</button>
                </div>
            </form>
            <div class="form-text mt-2">
                <i class="bi bi-info-circle me-1"></i> Khung giờ mới được ưu tiên: phần chồng lấn của các khung cũ sẽ tự động được cắt bớt để mỗi giờ chỉ tính theo đúng 1 mức giá.
                Khoảng giờ chưa có khung giá sẽ tính theo đơn giá mặc định 150.000 đ/giờ.
            </div>
        </div>
    </div>

    <!-- Existing TimeSlots List -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-stars me-2"></i> Bảng giá hiện tại</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Khung thời gian</th>
                            <th>Đơn giá</th>
                            <th>Phân loại</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TimeSlots.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Chưa có khung giờ nào được thiết lập. Hệ thống sẽ áp dụng đơn giá mặc định (150.000 đ/giờ).
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var slot in Model.TimeSlots.OrderBy(s => s.StartTime))
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        <i class="bi bi-clock me-1 text-primary"></i> @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td class="text-danger fw-bold fs-6">
                                        @slot.Price.ToString("N0") VNĐ
                                    </td>
                                    <td>
                                        @if (slot.IsPeakHour)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-fire me-1"></i> Giờ vàng / Cao điểm</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Bình thường</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="DeleteTimeSlot" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khung giờ này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="slotId" value="@slot.Id" />
                                            <input type="hidden" name="courtId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
