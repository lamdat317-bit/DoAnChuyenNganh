@model DACN.Models.ViewModels.TeamworkIndexViewModel
@using DACN.Models.Enums
@{
    ViewData["Title"] = "Ghép Đội & Tìm Kèo Giao Lưu Thể Thao (Teamwork)";
}

<!-- Cyber Hero Banner -->
<div class="position-relative py-5 text-white" style="background: radial-gradient(circle at 50% 0%, rgba(0, 255, 170, 0.12), transparent 70%), radial-gradient(circle at 80% 30%, rgba(59, 130, 246, 0.15), transparent 60%), #030712; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container position-relative z-1">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="cyber-announcement mb-3 d-inline-flex">
                    <span class="cyber-announcement-tag">TEAMWORK 🔥</span>
                    <span class="cyber-announcement-text">Cộng đồng giao lưu &amp; ghép slot thể thao toàn quốc</span>
                </div>
                <h1 class="cyber-title mb-2 fs-2 fs-md-1">
                    KẾT NỐI NGƯỜI CHƠI &amp; <span class="glow-cyan">GHÉP ĐỘI SIÊU TỐC</span>
                </h1>
                <p class="cyber-desc mb-0 fs-6 text-white-50" style="max-width: 680px;">
                    Thiếu slot đá bóng? Tìm bạn đánh Pickleball? Hay tìm đối thủ giao lưu cuối tuần? Tham gia ngay cộng đồng thể thao sôi động, giao lưu lành mạnh và fair-play!
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="MyMatches" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-person-lines-fill me-1"></i> Kèo của tôi
                </a>
                <a asp-action="Create" class="btn btn-sport-gradient rounded-pill px-4 py-2 fw-bold text-white shadow-lg">
                    <i class="bi bi-plus-circle-fill me-1"></i> + Đăng Kèo Mới
                </a>
            </div>
        </div>

        <!-- Quick Stats Row (Cyber Glass Cards) -->
        <div class="row g-3 mt-4 pt-3 border-top border-white border-opacity-10">
            <div class="col-md-4">
                <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px);">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #fbbf24;">
                        <i class="bi bi-fire fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">@Model.TotalOpenMatches</h4>
                        <span class="small text-white-50">Kèo đang mở tuyển thành viên</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px);">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #60a5fa;">
                        <i class="bi bi-person-plus-fill fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">@Model.TotalTeammateRecruiting</h4>
                        <span class="small text-white-50">Kèo tuyển slot đồng đội</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px);">
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399;">
                        <i class="bi bi-shield-shaded fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">@Model.TotalOpponentSearching</h4>
                        <span class="small text-white-50">Kèo tìm đối thủ giao hữu</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item text-white active" aria-current="page">Ghép Đội &amp; Tìm Kèo</li>
        </ol>
    </nav>

    <!-- Cyber Multi-Filter Bar -->
    <div class="card shadow-lg border-0 mb-4" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <!-- Keyword -->
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: rgba(255,255,255,0.15);"><i class="bi bi-search text-info"></i></span>
                        <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0 text-white" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15);" placeholder="Tìm theo tên sân, khu vực, tiêu đề..." />
                    </div>
                </div>

                <!-- Sport Type -->
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: rgba(255,255,255,0.15);"><i class="bi bi-trophy text-warning"></i></span>
                        <select name="sportTypeId" class="form-select border-start-0 text-white" style="background: #0f172a; border-color: rgba(255,255,255,0.15);">
                            <option value="" style="background: #0f172a;">-- Tất cả môn thể thao --</option>
                            @foreach (var s in Model.SportTypes)
                            {
                                <option value="@s.Id" selected="@(s.Id == Model.SelectedSportTypeId ? "selected" : null)" style="background: #0f172a;">
                                    @s.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Post Type -->
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: rgba(255,255,255,0.15);"><i class="bi bi-tag text-success"></i></span>
                        <select name="postType" class="form-select border-start-0 text-white" style="background: #0f172a; border-color: rgba(255,255,255,0.15);">
                            <option value="" style="background: #0f172a;">-- Mục đích: Tất cả --</option>
                            <option value="@((int)MatchPostType.FindTeammates)" selected="@(Model.SelectedPostType == MatchPostType.FindTeammates ? "selected" : null)" style="background: #0f172a;">
                                🤝 Tìm đồng đội (Ghép slot)
                            </option>
                            <option value="@((int)MatchPostType.FindOpponent)" selected="@(Model.SelectedPostType == MatchPostType.FindOpponent ? "selected" : null)" style="background: #0f172a;">
                                ⚔️ Tìm đối thủ giao lưu
                            </option>
                        </select>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sport-gradient btn-sm w-100 fw-bold rounded-pill text-white">
                        <i class="bi bi-funnel me-1"></i> Lọc Kèo
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-circle px-2" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Match Posts List Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-white d-flex align-items-center gap-2">
            <i class="bi bi-grid-fill text-info"></i> Danh sách kèo giao lưu (<span class="text-info">@Model.Posts.Count</span> kèo đang hoạt động)
        </h5>
        <span class="small text-white-50 d-none d-sm-inline">
            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Cập nhật thời gian thực
        </span>
    </div>

    <div class="row g-4">
        @if (!Model.Posts.Any())
        {
            <div class="col-12 text-center py-5 rounded-3 shadow-sm" style="background: #0f172a; border: 1px dashed rgba(255,255,255,0.15);">
                <i class="bi bi-inbox display-1 text-white-50"></i>
                <h5 class="mt-3 text-white">Chưa có bài đăng nào phù hợp với bộ lọc.</h5>
                <p class="text-white-50 small">Hãy là người đầu tiên tạo kèo để rủ rê các anh em khác tham gia!</p>
                <a asp-action="Create" class="btn btn-sport-gradient rounded-pill px-4 text-white fw-bold mt-2">
                    <i class="bi bi-plus-circle me-1"></i> Đăng Kèo Mới Ngay
                </a>
            </div>
        }
        else
        {
            @foreach (var post in Model.Posts)
            {
                <div class="col-md-6 col-lg-6">
                    <div class="card h-100 shadow-lg border-0 transition" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px; overflow: hidden;">
                        <!-- Glowing Top Border Indicator -->
                        <div style="height: 4px; background: @(post.PostType == MatchPostType.FindTeammates ? "linear-gradient(90deg, #3b82f6, #06b6d4)" : "linear-gradient(90deg, #ef4444, #f59e0b)");"></div>
                        
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Top Tags & Status -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <span class="badge py-1 px-2 d-inline-flex align-items-center" style="background: rgba(0, 255, 170, 0.1); color: #00ffaa; border: 1px solid rgba(0, 255, 170, 0.3); border-radius: 20px; font-size: 0.8rem;">
                                        <i class="@(post.SportIconCss ?? "bi bi-activity") me-1"></i> @post.SportName
                                    </span>
                                    @if (post.PostType == MatchPostType.FindTeammates)
                                    {
                                        <span class="badge py-1 px-2 d-inline-flex align-items-center" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 20px; font-size: 0.8rem;">
                                            <i class="bi bi-people-fill me-1"></i> Tuyển Slot Thiếu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge py-1 px-2 d-inline-flex align-items-center" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 20px; font-size: 0.8rem;">
                                            <i class="bi bi-shield-shaded me-1"></i> Tìm Đối Thủ
                                        </span>
                                    }
                                </div>
                                <div>
                                    @if (post.Status == MatchPostStatus.Open)
                                    {
                                        <span class="badge py-1 px-2" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 20px;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Đang mở
                                        </span>
                                    }
                                    else if (post.Status == MatchPostStatus.Full)
                                    {
                                        <span class="badge py-1 px-2" style="background: rgba(100, 116, 139, 0.2); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.4); border-radius: 20px;">
                                            <i class="bi bi-lock-fill me-1"></i> Đã đủ slot
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Post Title -->
                            <h5 class="fw-bold mb-2">
                                <a asp-action="Detail" asp-route-id="@post.Id" class="text-decoration-none text-white hover-cyan" style="transition: color 0.2s ease;">
                                    @post.Title
                                </a>
                            </h5>

                            <!-- Venue & Time Info -->
                            <div class="mb-3">
                                <div class="text-white-50 small mb-1">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    <strong class="text-white">@post.VenueName</strong>
                                    @if (!string.IsNullOrEmpty(post.VenueAddress))
                                    {
                                        <span> - @post.VenueAddress</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2 text-white-50 small mb-1 flex-wrap">
                                    <div>
                                        <i class="bi bi-calendar3 text-info me-1"></i>
                                        <strong class="text-white">@post.MatchDate.ToString("dd/MM/yyyy")</strong>
                                    </div>
                                    <span class="badge" style="background: rgba(255,255,255,0.08); color: #cbd5e1; border: 1px solid rgba(255,255,255,0.12);">
                                        <i class="bi bi-clock me-1 text-warning"></i> @post.StartTime.ToString(@"hh\:mm") - @post.EndTime.ToString(@"hh\:mm")
                                    </span>
                                </div>
                                <div class="text-white-50 small">
                                    <i class="bi bi-award-fill text-warning me-1"></i>
                                    Trình độ:
                                    <span class="fw-semibold text-white">
                                        @switch (post.SkillLevel)
                                        {
                                            case MatchSkillLevel.Beginner:
                                                <span>Mới chơi / Vui là chính</span>
                                                break;
                                            case MatchSkillLevel.Intermediate:
                                                <span>Trung bình / Đã biết chơi</span>
                                                break;
                                            case MatchSkillLevel.Advanced:
                                                <span>Khá - Bán chuyên</span>
                                                break;
                                            default:
                                                <span>Mọi trình độ / Giao lưu</span>
                                                break;
                                        }
                                    </span>
                                </div>
                            </div>

                            <!-- Progress Bar of Roster Slots -->
                            <div class="p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="d-flex justify-content-between align-items-center mb-2 small">
                                    <span class="text-white-50">
                                        <i class="bi bi-person-check-fill text-success me-1"></i> Đội hình hiện tại:
                                    </span>
                                    <span class="fw-bold @(post.MissingSlots == 0 ? "text-success" : "text-warning")">
                                        @post.CurrentSlots / @post.TotalSlots người
                                        @(post.MissingSlots > 0 ? $"(Cần thêm {post.MissingSlots} người)" : "(Đã đủ đội hình)")
                                    </span>
                                </div>
                                <div class="progress" style="height: 8px; background: rgba(255, 255, 255, 0.1); border-radius: 4px;">
                                    <div class="progress-bar @(post.ProgressPercent >= 100 ? "bg-success" : "bg-info") progress-bar-striped progress-bar-animated"
                                         role="progressbar" style="width: @post.ProgressPercent%; border-radius: 4px;"></div>
                                </div>
                            </div>

                            <!-- Footer Card: Cost & Action -->
                            <div class="mt-auto pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-white-50 d-block" style="font-size: 0.75rem;">Chi phí chia sẻ:</small>
                                    @if (post.CostPerPerson > 0)
                                    {
                                        <span class="text-danger fw-bold fs-5">@post.CostPerPerson.ToString("N0") đ</span>
                                        <small class="text-white-50">/người</small>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold fs-6">Miễn phí / Bao sân</span>
                                    }
                                </div>
                                <a asp-action="Detail" asp-route-id="@post.Id" class="btn btn-sport-gradient rounded-pill px-3 py-1 fw-bold text-white small shadow-sm">
                                    Chi tiết &amp; Tham gia <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
