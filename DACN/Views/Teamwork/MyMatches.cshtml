@model DACN.Models.ViewModels.MyMatchesViewModel
@using DACN.Models.Enums
@{
    ViewData["Title"] = "Kèo Thể Thao Của Tôi (Teamwork)";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-white-50 text-decoration-none">Ghép đội &amp; Tìm kèo</a></li>
            <li class="breadcrumb-item text-white active" aria-current="page">Kèo của tôi</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-white d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-info"></i> Quản Lý Kèo Của Tôi
            </h2>
            <p class="text-white-50 mb-0">Theo dõi các trận đấu bạn làm đội trưởng và các kèo bạn đã xin gia nhập</p>
        </div>
        <a asp-action="Create" class="btn btn-sport-gradient fw-bold text-white shadow-lg rounded-pill px-4">
            <i class="bi bi-plus-circle-fill me-1"></i> + Đăng Kèo Mới
        </a>
    </div>

    <!-- Nav tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="myMatchesTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2 fw-bold rounded-pill" id="created-tab" data-bs-toggle="pill" data-bs-target="#created-content" type="button" role="tab">
                <i class="bi bi-star-fill text-warning me-1"></i> Kèo tôi làm Đội trưởng (@Model.MyCreatedPosts.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 fw-bold rounded-pill text-white-50" id="joined-tab" data-bs-toggle="pill" data-bs-target="#joined-content" type="button" role="tab">
                <i class="bi bi-person-check-fill me-1"></i> Kèo tôi xin gia nhập (@Model.MyJoinedRequests.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="myMatchesTabContent">
        <!-- Tab 1: Kèo tôi tạo -->
        <div class="tab-pane fade show active" id="created-content" role="tabpanel">
            @if (!Model.MyCreatedPosts.Any())
            {
                <div class="card border-0 shadow-lg p-5 text-center" style="background: #0f172a; border: 1px dashed rgba(255, 255, 255, 0.15) !important; border-radius: 16px;">
                    <i class="bi bi-calendar-plus display-1 text-white-50"></i>
                    <h5 class="mt-3 text-white">Bạn chưa tạo bài đăng tìm kèo nào.</h5>
                    <p class="text-white-50 small">Hãy tạo kèo mới để rủ bạn bè hoặc các tay chơi xung quanh tham gia!</p>
                    <div>
                        <a asp-action="Create" class="btn btn-sport-gradient rounded-pill px-4 text-white fw-bold mt-2">
                            <i class="bi bi-plus-circle me-1"></i> Tạo Kèo Ngay
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var post in Model.MyCreatedPosts)
                    {
                        var pendingCount = post.JoinRequests.Count(r => r.Status == JoinRequestStatus.Pending);
                        <div class="col-md-6">
                            <div class="card h-100 shadow-lg border-0 transition" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px; overflow: hidden;">
                                <div style="height: 4px; background: linear-gradient(90deg, #f59e0b, #ef4444);"></div>
                                <div class="card-body p-4 d-flex flex-column text-white">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge py-1 px-3 d-inline-flex align-items-center" style="background: rgba(0, 255, 170, 0.1); color: #00ffaa; border: 1px solid rgba(0, 255, 170, 0.3); border-radius: 20px; font-size: 0.8rem;">
                                            <i class="@(post.SportType?.IconCss ?? "bi bi-activity") me-1"></i> @post.SportType?.Name
                                        </span>
                                        @if (pendingCount > 0)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-1">
                                                <i class="bi bi-bell-fill me-1"></i> @pendingCount yêu cầu chờ duyệt
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge py-1 px-3" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 20px;">
                                                <i class="bi bi-check-circle-fill me-1"></i> Đang mở
                                            </span>
                                        }
                                    </div>

                                    <h5 class="fw-bold mb-2">
                                        <a asp-action="Detail" asp-route-id="@post.Id" class="text-white text-decoration-none hover-cyan">
                                            @post.Title
                                        </a>
                                    </h5>
                                    <div class="text-white-50 small mb-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @post.VenueName
                                    </div>
                                    <div class="text-white-50 small mb-3">
                                        <i class="bi bi-calendar3 text-info me-1"></i> @post.MatchDate.ToString("dd/MM/yyyy") |
                                        <i class="bi bi-clock text-warning me-1"></i> @post.StartTime.ToString(@"hh\:mm") - @post.EndTime.ToString(@"hh\:mm")
                                    </div>

                                    <div class="p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                                        <div class="d-flex justify-content-between mb-1 small">
                                            <span class="text-white-50">Thành viên:</span>
                                            <strong class="text-white">@post.CurrentSlots / @post.TotalSlots slots</strong>
                                        </div>
                                        <div class="progress" style="height: 6px; background: rgba(255, 255, 255, 0.1); border-radius: 3px;">
                                            <div class="progress-bar bg-success" style="width: @(post.TotalSlots > 0 ? (int)((float)post.CurrentSlots / post.TotalSlots * 100) : 0)%; border-radius: 3px;"></div>
                                        </div>
                                    </div>

                                    <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-danger fs-5">@(post.CostPerPerson > 0 ? $"{post.CostPerPerson:N0} đ/người" : "Bao sân")</span>
                                        <div class="d-flex gap-2">
                                            <form asp-action="DeletePost" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa kèo này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Xóa bài đăng kèo này">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                            <a asp-action="Detail" asp-route-id="@post.Id" class="btn btn-sport-gradient btn-sm fw-bold rounded-pill text-white px-3">
                                                <i class="bi bi-gear-fill me-1"></i> Quản lý &amp; Duyệt
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Tab 2: Kèo tôi xin gia nhập -->
        <div class="tab-pane fade" id="joined-content" role="tabpanel">
            @if (!Model.MyJoinedRequests.Any())
            {
                <div class="card border-0 shadow-lg p-5 text-center" style="background: #0f172a; border: 1px dashed rgba(255, 255, 255, 0.15) !important; border-radius: 16px;">
                    <i class="bi bi-inbox display-1 text-white-50"></i>
                    <h5 class="mt-3 text-white">Bạn chưa gửi yêu cầu xin gia nhập kèo nào.</h5>
                    <p class="text-white-50 small">Hãy dạo một vòng bảng tin để tìm trận đấu phù hợp với lịch rảnh của bạn!</p>
                    <div>
                        <a asp-action="Index" class="btn btn-sport-gradient rounded-pill px-4 text-white fw-bold mt-2">
                            <i class="bi bi-search me-1"></i> Khám Phá Kèo Thể Thao
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var req in Model.MyJoinedRequests)
                    {
                        var post = req.MatchPost;
                        if (post == null) continue;
                        <div class="col-md-6">
                            <div class="card h-100 shadow-lg border-0" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 16px;">
                                <div class="card-body p-4 d-flex flex-column text-white">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge py-1 px-3 d-inline-flex align-items-center" style="background: rgba(0, 255, 170, 0.1); color: #00ffaa; border: 1px solid rgba(0, 255, 170, 0.3); border-radius: 20px; font-size: 0.8rem;">
                                            <i class="@(post.SportType?.IconCss ?? "bi bi-activity") me-1"></i> @post.SportType?.Name
                                        </span>
                                        @switch (req.Status)
                                        {
                                            case JoinRequestStatus.Pending:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-hourglass-split me-1"></i> Chờ đội trưởng duyệt</span>
                                                break;
                                            case JoinRequestStatus.Accepted:
                                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle-fill me-1"></i> Đã được chấp nhận</span>
                                                break;
                                            case JoinRequestStatus.Rejected:
                                                <span class="badge bg-danger rounded-pill px-3 py-1"><i class="bi bi-x-circle me-1"></i> Đã từ chối</span>
                                                break;
                                        }
                                    </div>

                                    <h5 class="fw-bold mb-2">
                                        <a asp-action="Detail" asp-route-id="@post.Id" class="text-white text-decoration-none hover-cyan">
                                            @post.Title
                                        </a>
                                    </h5>
                                    <div class="text-white-50 small mb-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @post.VenueName
                                    </div>
                                    <div class="text-white-50 small mb-2">
                                        <i class="bi bi-calendar3 text-info me-1"></i> @post.MatchDate.ToString("dd/MM/yyyy") |
                                        <i class="bi bi-clock text-warning me-1"></i> @post.StartTime.ToString(@"hh\:mm") - @post.EndTime.ToString(@"hh\:mm")
                                    </div>

                                    <div class="p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                                        <div class="small mb-1"><span class="text-white-50">Vị trí đăng ký:</span> <strong class="text-white">@(req.PreferredPosition ?? "Đá tự do")</strong></div>
                                        <div class="small"><span class="text-white-50">Đội trưởng:</span> <strong class="text-white">@(post.Creator?.FullName ?? "Đội trưởng")</strong> (@post.ContactPhone)</div>
                                    </div>

                                    <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                        @if (req.Status == JoinRequestStatus.Pending)
                                        {
                                            <form asp-action="CancelRequest" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy yêu cầu tham gia này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@req.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                                    <i class="bi bi-x-circle me-1"></i> Hủy yêu cầu
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                        <a asp-action="Detail" asp-route-id="@post.Id" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                            Xem chi tiết kèo <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
