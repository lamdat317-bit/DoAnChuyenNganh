@model DACN.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-wrap">
    <div class="container" style="max-width: 520px;">
        <div class="panel p-4 p-md-5">
            <span class="icon-bubble lg green mb-3"><i class="bi bi-shield-lock"></i></span>
            <h3 class="fw-bold mb-1">Tạo mật khẩu mới</h3>
            <p class="text-muted mb-4">Cho tài khoản <strong class="text-ink">@Model.Email</strong></p>

            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Ít nhất 6 ký tự" id="rpNew" autofocus />
                        <button type="button" class="btn btn-light border" onclick="togglePwd('rpNew', this)" aria-label="Hiện mật khẩu"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Đổi mật khẩu</button>
            </form>
            <div class="text-center mt-4 small"><a asp-action="ForgotPassword">Link hết hạn? Gửi lại link mới</a></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(id, btn) {
            const input = document.getElementById(id);
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
        }
    </script>
}
