@model DACN.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân - SanBong.vn";
}

<div class="container py-4" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hồ sơ cá nhân</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Player Card Badge -->
        <div class="col-md-5">
            <div class="card shadow-lg border-0 text-white p-4 text-center hero-gradient position-relative overflow-hidden">
                <div class="position-relative z-1">
                    <div class="bg-white text-dark rounded-circle mx-auto p-3 mb-3 d-flex align-items-center justify-content-center shadow"
                         style="width: 80px; height: 80px; font-size: 2.2rem;">
                        <i class="bi bi-person-fill text-success"></i>
                    </div>

                    <h4 class="fw-bold mb-1">@Model.User.FullName</h4>
                    <p class="text-white-50 small mb-3">@Model.User.Email</p>

                    <div class="badge bg-warning text-dark px-3 py-2 fs-6 fw-bold mb-4">
                        <i class="bi bi-shield-shaded me-1"></i> Thành viên VIP: @Model.VipTier
                    </div>

                    <div class="p-3 bg-white bg-opacity-10 rounded-3 text-start small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-white-50">Vai trò:</span>
                            <strong class="text-warning">@Model.User.Role</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-white-50">Số điện thoại:</span>
                            <strong>@(Model.User.PhoneNumber ?? "Chưa cập nhật")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-white-50">Tham gia từ:</span>
                            <strong>@Model.User.CreatedAt.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline-light btn-sm w-100 mt-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa thông tin cá nhân
                    </button>
                </div>
            </div>
        </div>

        <!-- Activity Stats -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 p-4 bg-white h-100">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">
                    <i class="bi bi-bar-chart-line-fill text-primary me-2"></i> Hoạt Động & Thành Tích Thể Thao
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 text-center border">
                            <i class="bi bi-calendar2-check-fill fs-2 text-success mb-2"></i>
                            <h3 class="fw-bold mb-0 text-dark">@Model.TotalBookings</h3>
                            <span class="text-muted small">Lượt đặt sân</span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 text-center border">
                            <i class="bi bi-people-fill fs-2 text-primary mb-2"></i>
                            <h3 class="fw-bold mb-0 text-dark">@Model.TotalMatchesJoined</h3>
                            <span class="text-muted small">Trận đã ghép đội</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center border">
                            <div>
                                <span class="text-muted small d-block">Tổng chi tiêu thể thao:</span>
                                <h4 class="fw-bold mb-0 text-danger">@Model.TotalSpent.ToString("N0") VNĐ</h4>
                            </div>
                            <i class="bi bi-wallet2 fs-1 text-warning"></i>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-auto">
                    <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-primary flex-grow-1">
                        <i class="bi bi-ticket-perforated me-1"></i> Xem lịch sử đặt sân
                    </a>
                    <a asp-controller="Teamwork" asp-action="MyMatches" class="btn btn-outline-warning text-dark flex-grow-1 fw-bold">
                        <i class="bi bi-people me-1"></i> Xem các kèo của tôi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh Sửa Thông Tin Cá Nhân -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-person-gear me-2"></i> Chỉnh Sửa Thông Tin Cá Nhân
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Họ và tên</label>
                        <input type="text" name="FullName" value="@Model.User.FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Số điện thoại</label>
                        <input type="tel" name="PhoneNumber" value="@Model.User.PhoneNumber" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Email (Tài khoản đăng nhập)</label>
                        <input type="email" value="@Model.User.Email" class="form-control bg-light" readonly disabled />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
