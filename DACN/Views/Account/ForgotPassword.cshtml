@model DACN.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-wrap">
    <div class="container" style="max-width: 520px;">
        <div class="panel p-4 p-md-5">
            <span class="icon-bubble lg green mb-3"><i class="bi bi-key"></i></span>
            <h3 class="fw-bold mb-1">Quên mật khẩu?</h3>
            <p class="text-muted mb-4">Nhập email đã đăng ký, chúng tôi sẽ gửi link để bạn tạo mật khẩu mới.</p>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@gmail.com" autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-send me-1"></i>Gửi link đặt lại mật khẩu</button>
            </form>

            <div class="text-center mt-4 small">
                <a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
