@model DACN.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập - SanBong.vn";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card shadow-xl border-0 overflow-hidden" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 20px;">
                <div class="row g-0">
                    <!-- Left Hero Col (Cyber Gradient) -->
                    <div class="col-md-5 text-white p-5 d-flex flex-column justify-content-between position-relative" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(59, 130, 246, 0.2) 100%), #070d19; border-right: 1px solid rgba(255, 255, 255, 0.08);">
                        <div>
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white text-decoration-none d-flex align-items-center gap-2 mb-4">
                                <span class="brand-ball-icon">
                                    <i class="bi bi-dribbble"></i>
                                </span>
                                <span class="fs-4 fw-bold">SanBong<span class="text-success">.vn</span></span>
                            </a>
                            <h3 class="fw-bold mb-3 text-white">Chào Mừng Trở Lại!</h3>
                            <p class="text-white-50 small mb-4">
                                Nền tảng kết nối người chơi và quản lý dịch vụ đặt sân thể thao trực tuyến hàng đầu Việt Nam.
                            </p>
                        </div>

                        <!-- Highlights -->
                        <div class="d-flex flex-column gap-3 small text-white-75">
                            <div><i class="bi bi-shield-check text-success me-2 fs-6"></i> 100% Chống trùng lịch (Serializable Safe)</div>
                            <div><i class="bi bi-qr-code text-warning me-2 fs-6"></i> Thanh toán giữ chỗ tự động qua VietQR 24/7</div>
                            <div><i class="bi bi-people-fill text-info me-2 fs-6"></i> Ghép đội thể thao sôi động &amp; tìm kèo thi đấu</div>
                            <div><i class="bi bi-geo-alt-fill text-danger me-2 fs-6"></i> Bản đồ Google Maps dẫn đường tận sân</div>
                        </div>

                        <div class="mt-4 pt-3 border-top border-white border-opacity-10 text-white-50 small">
                            &copy; @DateTime.Now.Year SanBong.vn • Hệ thống thể thao thông minh
                        </div>
                    </div>

                    <!-- Right Form Col (Cyber Dark) -->
                    <div class="col-md-7 p-4 p-md-5 text-white" style="background: #0f172a;">
                        <div class="mb-4">
                            <h4 class="fw-bold text-white mb-1">Đăng nhập tài khoản</h4>
                            <p class="text-white-50 small">Nhập email hoặc tên đăng nhập của bạn để tiếp tục</p>
                        </div>

                        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="EmailOrUsername" class="form-label fw-semibold small text-white"></label>
                                <div class="input-group">
                                    <span class="input-group-text text-white-50" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="EmailOrUsername" class="form-control text-white" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);" placeholder="name@gmail.com" />
                                </div>
                                <span asp-validation-for="EmailOrUsername" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label asp-for="Password" class="form-label fw-semibold small mb-0 text-white"></label>
                                    <a href="#" class="small text-decoration-none text-white-50 hover-cyan">Quên mật khẩu?</a>
                                </div>
                                <div class="input-group mt-1">
                                    <span class="input-group-text text-white-50" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control text-white" style="background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15);" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-white-50"></label>
                            </div>

                            <button type="submit" class="btn btn-sport-gradient w-100 py-2 fs-6 fw-bold mb-3 rounded-pill text-white shadow-lg">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Ngay
                            </button>

                            <div class="text-center small text-white-50">
                                Chưa có tài khoản?
                                <a asp-action="Register" class="fw-bold text-success text-decoration-none hover-cyan">Đăng ký tài khoản Khách Hàng mới</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
