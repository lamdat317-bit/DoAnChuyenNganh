@{
    ViewData["Title"] = "Kiểm tra email";
    var devLink = ViewBag.DevResetLink as string;
}

<div class="auth-wrap">
    <div class="container" style="max-width: 560px;">
        <div class="panel p-4 p-md-5 text-center">
            <span class="icon-bubble lg green mb-3"><i class="bi bi-envelope-check"></i></span>
            <h3 class="fw-bold mb-2">Kiểm tra hộp thư của bạn</h3>
            <p class="text-muted mb-4">Nếu email này đã đăng ký tài khoản, chúng tôi vừa gửi link đặt lại mật khẩu. Link có hiệu lực trong <strong>2 giờ</strong>. Nhớ kiểm tra cả mục Spam.</p>

            @if (!string.IsNullOrEmpty(devLink))
            {
                <div class="alert alert-warning text-start small">
                    <div class="fw-bold mb-1"><i class="bi bi-cone-striped me-1"></i>Chế độ demo (Development)</div>
                    Máy chủ chưa cấu hình SMTP nên email chưa được gửi thật — email đã được lưu trong <em>Quản trị → Hộp thư hệ thống</em>. Dùng link dưới đây để thử chức năng:
                    <a href="@devLink" class="btn btn-primary btn-sm w-100 mt-2"><i class="bi bi-key me-1"></i>Mở link đặt lại mật khẩu</a>
                </div>
            }

            <a asp-action="Login" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập</a>
        </div>
    </div>
</div>
