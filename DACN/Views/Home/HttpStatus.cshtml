@{
    int code = ViewBag.Code ?? 404;
    var (title, message, icon) = code switch
    {
        404 => ("Không tìm thấy trang", "Trang bạn tìm có thể đã bị xóa, đổi đường dẫn hoặc tạm thời không truy cập được.", "bi-signpost-split"),
        403 => ("Bạn không có quyền truy cập", "Tài khoản hiện tại không được phép xem nội dung này.", "bi-shield-lock"),
        401 => ("Vui lòng đăng nhập", "Bạn cần đăng nhập để tiếp tục.", "bi-person-lock"),
        >= 500 => ("Hệ thống đang gặp sự cố", "Vui lòng thử lại sau ít phút. Chúng tôi đang khắc phục.", "bi-tools"),
        _ => ("Đã có lỗi xảy ra", "Yêu cầu không thể xử lý lúc này.", "bi-exclamation-octagon")
    };
    ViewData["Title"] = title;
}

<section class="error-page">
    <div class="container text-center">
        <div class="error-code" aria-hidden="true">@code</div>
        <span class="icon-bubble lg green mb-3"><i class="bi @icon"></i></span>
        <h1 class="h3 fw-extrabold mb-2">@title</h1>
        <p class="text-muted mx-auto mb-4" style="max-width:460px">@message</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i> Về trang chủ</a>
            <a asp-controller="Booking" asp-action="Index" class="btn btn-light"><i class="bi bi-search me-1"></i> Tìm sân</a>
            <button type="button" class="btn btn-light" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i> Quay lại</button>
        </div>
    </div>
</section>
