@model DACN.Models.Booking
@using DACN.Services
@{
    ViewData["Title"] = "Thanh toán đơn #BK-" + Model.Id;
    var remainingSeconds = DACN.Services.BookingRules.HoldRemainingSeconds(Model, DateTime.UtcNow);
    var initialTimerDisplay = $"{remainingSeconds / 60:D2}:{remainingSeconds % 60:D2}";
    var vi = new System.Globalization.CultureInfo("vi-VN");

    // Ví ngân hàng ảo
    var wallet = (DACN.Models.BankAccount)ViewBag.Wallet;
    var isOwnBooking = ViewBag.IsOwnBooking == true;
    var amount = Money.ToVnd(Model.TotalAmount);
    var enough = wallet.Balance >= amount;
    var shortfall = Math.Max(0, amount - wallet.Balance);
    var otp = TempData["PaymentOtp"] as string;
    // TempData tự đổi chuỗi ngày giờ thành DateTime khi đọc lại → chấp nhận cả 2 kiểu
    DateTime? otpExpires = TempData["PaymentOtpExpires"] switch
    {
        DateTime d => d.ToUniversalTime(),
        string s when DateTime.TryParse(s, null, System.Globalization.DateTimeStyles.RoundtripKind, out var oe) => oe.ToUniversalTime(),
        _ => null
    };
    var otpSeconds = otpExpires.HasValue ? Math.Max(0, (int)(otpExpires.Value - DateTime.UtcNow).TotalSeconds) : 0;
}

<div class="page-header">
    <div class="container" style="max-width: 1080px;">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="MyBookings">Lịch đặt của tôi</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1>Thanh toán đơn #BK-@Model.Id</h1>
                <p class="sub">Thanh toán bằng ví DatSan247, xác nhận bằng mã OTP. Tiền chuyển thẳng cho chủ sân.</p>
            </div>
            <div class="countdown-badge fs-6" title="Thời gian giữ chỗ còn lại">
                <i class="bi bi-stopwatch"></i> Còn <span id="countdownTimer">@initialTimerDisplay</span>
            </div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 1080px;">
    <div class="row g-4">
        <div class="col-lg-7">
            @if (!isOwnBooking)
            {
                <div class="panel">
                    <div class="panel-body text-center p-4">
                        <span class="icon-bubble lg slate mb-3"><i class="bi bi-person-lock"></i></span>
                        <h5 class="fw-bold">Chỉ khách đặt đơn mới thanh toán được</h5>
                        <p class="text-muted small mb-0">Đơn này thuộc tài khoản khác. Bạn có thể xem chi tiết đơn ở trang quản lý.</p>
                    </div>
                </div>
            }
            else
            {
            <div class="panel mb-4">
                <div class="panel-header">
                    <h5 class="panel-title"><i class="bi bi-wallet2"></i> Thanh toán bằng ví DatSan247</h5>
                    <a asp-controller="Wallet" asp-action="Index" class="small">Internet Banking <i class="bi bi-box-arrow-up-right"></i></a>
                </div>
                <div class="panel-body">
                    <div class="summary-row"><span class="k">Tài khoản</span><span class="v font-monospace">@wallet.AccountNo</span></div>
                    <div class="summary-row"><span class="k">Số dư hiện tại</span><span class="v fw-bold @(enough ? "text-success" : "text-danger")">@Money.Vnd(wallet.Balance)</span></div>
                    <div class="summary-row"><span class="k">Cần thanh toán</span><span class="v text-accent fw-bold">@Money.Vnd(amount)</span></div>
                    <div class="summary-row"><span class="k">Số dư sau thanh toán</span><span class="v">@(enough ? Money.Vnd(wallet.Balance - amount) : "—")</span></div>

                    @if (!enough)
                    {
                        <div class="alert alert-danger small mt-3 mb-0 d-flex flex-wrap align-items-center gap-2">
                            <i class="bi bi-exclamation-octagon"></i>
                            <span class="flex-grow-1">Số dư không đủ. Bạn cần nạp thêm ít nhất <strong>@Money.Vnd(shortfall)</strong>.</span>
                            <a asp-controller="Wallet" asp-action="Index" asp-route-returnUrl="@Url.Action("Checkout", new { bookingId = Model.Id })" class="btn btn-sm btn-danger"><i class="bi bi-plus-circle me-1"></i>Nạp tiền</a>
                        </div>
                    }
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <h5 class="panel-title"><i class="bi bi-shield-lock"></i> Xác nhận bằng mã OTP</h5>
                    <span class="badge-soft neutral">OTP giả lập · @PaymentPolicy.OtpMinutes phút</span>
                </div>
                <div class="panel-body">
                    @if (otp == null)
                    {
                        <p class="small text-muted">Bấm gửi mã, hệ thống sinh mã OTP 6 số (giả lập SMS: hiện ngay trên màn hình và in ra console server). Mã hết hạn sau @PaymentPolicy.OtpMinutes phút.</p>
                        <form asp-action="RequestPaymentOtp" method="post" data-once>
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary btn-lg w-100" @(enough ? "" : "disabled")>
                                <i class="bi bi-send me-1"></i> Gửi mã OTP
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="rounded-3 p-3 mb-3 text-center" style="background: var(--warning-50); border: 1px dashed #f59e0b;">
                            <div class="small text-muted"><i class="bi bi-phone me-1"></i>Tin nhắn OTP (giả lập)</div>
                            <div class="font-monospace fw-bold" style="font-size: 2rem; letter-spacing: .4em;">@otp</div>
                            <div class="small">Hết hạn sau <strong id="otpTimer">--:--</strong></div>
                        </div>
                        <form asp-action="ConfirmPayment" method="post" data-once>
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <label class="form-label" for="otpInput">Nhập mã OTP</label>
                            <input type="text" id="otpInput" name="otp" class="form-control form-control-lg text-center font-monospace mb-3"
                                   inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus placeholder="••••••" />
                            <button type="submit" class="btn btn-primary btn-lg w-100" id="btnConfirmPay">
                                <i class="bi bi-check2-circle me-1"></i> Xác nhận thanh toán @Money.Vnd(amount)
                            </button>
                        </form>
                        <form asp-action="RequestPaymentOtp" method="post" class="text-center mt-2">
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <button type="submit" class="btn btn-link btn-sm">Gửi lại mã</button>
                        </form>
                    }
                </div>
            </div>
            }
        </div>

        <div class="col-lg-5">
            <div class="panel sticky-side">
                <div class="panel-header">
                    <h5 class="panel-title"><i class="bi bi-receipt"></i> Tóm tắt đơn</h5>
                    <span class="kbd-tag">#BK-@Model.Id</span>
                </div>
                <div class="panel-body">
                    <div class="d-flex gap-3 align-items-start mb-3">
                        <span class="icon-bubble green"><i class="bi bi-geo-alt"></i></span>
                        <div class="min-w-0">
                            <div class="fw-bold text-ink">@(Model.Court?.Facility?.Name ?? "Cụm sân")</div>
                            <div class="small text-muted">@(Model.Court?.Facility?.Address ?? "")</div>
                        </div>
                    </div>
                    <div class="summary-row"><span class="k">Sân</span><span class="v">@(Model.Court?.Name ?? "Sân") · @(Model.Court?.Facility?.SportType?.Name ?? "")</span></div>
                    <div class="summary-row"><span class="k">Ngày</span><span class="v">@Model.BookingDate.ToString("dddd, dd/MM/yyyy", vi)</span></div>
                    <div class="summary-row"><span class="k">Giờ</span><span class="v text-success">@DACN.Services.BookingRules.Hm(Model.StartTime) – @DACN.Services.BookingRules.Hm(Model.EndTime)</span></div>
                    <div class="summary-row"><span class="k">Người đặt</span><span class="v">@(Model.CustomerName ?? Model.Customer?.FullName ?? "Khách")</span></div>
                    <div class="summary-row"><span class="k">Điện thoại</span><span class="v">@(Model.CustomerPhone ?? Model.Customer?.PhoneNumber ?? "—")</span></div>
                    @if (Model.ServiceDetails != null && Model.ServiceDetails.Any())
                    {
                        foreach (var sd in Model.ServiceDetails)
                        {
                            <div class="summary-row"><span class="k">@(sd.FacilityService?.Name ?? "Dịch vụ") ×@sd.Quantity</span><span class="v">@sd.SubTotal.ToString("N0")đ</span></div>
                        }
                    }
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mt-3" style="background: var(--brand-50); border: 1px solid var(--brand-100);">
                        <span class="fw-semibold text-ink">Tổng thanh toán</span>
                        <span class="price fs-4">@Model.TotalAmount.ToString("N0")đ</span>
                    </div>
                    <a asp-action="MyBookings" class="btn btn-light w-100 mt-3"><i class="bi bi-clock me-1"></i> Thanh toán sau</a>
                    <div class="small text-muted text-center mt-2">Quá thời gian giữ chỗ, đơn sẽ tự hủy để nhường sân cho người khác.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Đếm ngược thời gian giữ chỗ
        let timeLeft = @remainingSeconds;
        const timerDisplay = document.getElementById('countdownTimer');
        const expiredUrl = '@Html.Raw(Url.Action("Matrix", "Booking", new { courtId = Model.CourtId, date = Model.BookingDate.ToString("yyyy-MM-dd") }))';
        const holdInterval = setInterval(function () {
            if (timeLeft <= 0) {
                clearInterval(holdInterval);
                timerDisplay.textContent = '00:00';
                document.querySelectorAll('form[data-once] button[type=submit]').forEach(function (b) { b.disabled = true; });
                setTimeout(function () { window.location.href = expiredUrl; }, 2500);
                return;
            }
            timerDisplay.textContent = String(Math.floor(timeLeft / 60)).padStart(2, '0') + ':' + String(timeLeft % 60).padStart(2, '0');
            timeLeft--;
        }, 1000);

        // Đếm ngược hạn OTP
        let otpLeft = @otpSeconds;
        const otpTimer = document.getElementById('otpTimer');
        if (otpTimer) {
            const tick = function () {
                if (otpLeft <= 0) {
                    otpTimer.textContent = 'đã hết hạn, bấm "Gửi lại mã"';
                    const btn = document.getElementById('btnConfirmPay');
                    if (btn) btn.disabled = true;
                    return;
                }
                otpTimer.textContent = String(Math.floor(otpLeft / 60)).padStart(2, '0') + ':' + String(otpLeft % 60).padStart(2, '0');
                otpLeft--;
                setTimeout(tick, 1000);
            };
            tick();
        }

        // Chống bấm 2 lần ở phía giao diện (server vẫn khóa dòng + idempotent)
        document.querySelectorAll('form[data-once]').forEach(function (form) {
            form.addEventListener('submit', function () {
                const btn = form.querySelector('button[type=submit]');
                if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...'; }
            });
        });
    </script>
}
