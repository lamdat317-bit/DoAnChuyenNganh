    <!-- Live Transactions Ledger Table -->
    <div class="card border-0 rounded-4 shadow-lg" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
        <div class="card-header py-3 px-4 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center" style="background: #1f2937;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-info fs-5"></i>
                <h5 class="fw-bold mb-0 text-white">Nhật Ký Giao Dịch & Minh Chứng Tiền Vào</h5>
            </div>
            <span class="badge bg-primary rounded-pill px-3 py-1">@Model.Count đơn gần nhất</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-white-50">
                    <i class="bi bi-inbox display-4 d-block mb-2 text-secondary"></i>
                    Chưa có giao dịch chuyển khoản nào được ghi nhận.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                        <thead>
                            <tr class="text-white-50 small border-bottom border-secondary border-opacity-25" style="background: rgba(255,255,255,0.02);">
                                <th class="ps-4 py-3">Mã GD / Thời gian</th>
                                <th>Đơn đặt sân</th>
                                <th>Khách hàng gửi</th>
                                <th>Số tiền chuyển</th>
                                <th>Phương thức</th>
                                <th>Ảnh minh chứng</th>
                                <th class="text-end pe-4">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bk in Model)
                            {
                                var paidTime = bk.PaidAt ?? bk.CreatedAt;
                                <tr class="border-bottom border-secondary border-opacity-25">
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-white small">@(string.IsNullOrEmpty(bk.PaymentTransactionRef) ? $"TXN-{bk.Id}" : bk.PaymentTransactionRef)</div>
                                        <div class="small text-white-50" style="font-size: 0.75rem;">
                                            <i class="bi bi-calendar-event me-1"></i>@paidTime.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <a asp-action="Confirmation" asp-route-bookingId="@bk.Id" class="text-decoration-none fw-bold text-info">
                                            #BK-@bk.Id
                                        </a>
                                        <div class="small text-white-50">
                                            @(bk.Court?.Facility?.Name ?? "Cụm sân") • @(bk.Court?.Name ?? "Sân")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-white small">@(bk.Customer?.FullName ?? "Khách hàng")</div>
                                        <div class="small text-white-50" style="font-size: 0.75rem;">@(bk.Customer?.PhoneNumber ?? bk.Customer?.Email ?? "")</div>
                                    </td>
                                    <td>
                                        <div class="fs-6 fw-bold text-success">+@bk.TotalAmount.ToString("N0") đ</div>
                                        <div class="small text-white-50" style="font-size: 0.75rem;">ND: BK@(bk.Id)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-50 text-white-50 small">
                                            @(bk.PaymentMethod ?? "VirtualBank")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(bk.PaymentProofImage))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2 rounded-pill small" onclick="viewProofModal('@bk.PaymentProofImage', '#BK-@bk.Id')">
                                                <i class="bi bi-image me-1"></i> Xem minh chứng
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-white-50 small"><em>Chưa đính kèm</em></span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <span class="badge bg-success text-dark fw-bold px-3 py-1 rounded-pill">
                                            <i class="bi bi-check2-circle me-1"></i> Tiền đã vào TK
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal xem ảnh minh chứng -->
<div class="modal fade" id="modalProofView" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1) !important;">
            <div class="modal-header border-bottom border-secondary border-opacity-25 text-white">
                <h5 class="modal-title fw-bold" id="modalProofTitle">Ảnh minh chứng chuyển khoản</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <img id="modalProofImg" src="" alt="Minh chứng" class="img-fluid rounded-3 shadow-lg" style="max-height: 550px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewProofModal(url, title) {
            document.getElementById('modalProofImg').src = url;
            document.getElementById('modalProofTitle').textContent = 'Minh chứng chuyển khoản đơn ' + title;
            new bootstrap.Modal(document.getElementById('modalProofView')).show();
        }
    </script>
}

