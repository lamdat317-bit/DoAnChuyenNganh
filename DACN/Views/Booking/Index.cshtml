@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('searchForm');
            var range = document.getElementById('priceRange');
            function syncPrice() {
                var parts = (range.value || '-').split('-');
                document.getElementById('minPrice').value = parts[0] || '';
                document.getElementById('maxPrice').value = parts[1] || '';
            }
            form.addEventListener('submit', syncPrice);
            form.querySelectorAll('[data-autosubmit]').forEach(function (el) {
                el.addEventListener('change', function () { form.requestSubmit ? form.requestSubmit() : form.submit(); });
            });

            // Lưới / danh sách / bản đồ (ghi nhớ lựa chọn)
            var grid = document.getElementById('venueGrid');
            var listView = document.getElementById('listView');
            var mapView = document.getElementById('mapView');
            var btns = document.querySelectorAll('.view-toggle [data-view]');
            function setView(v) {
                if (!grid) return;
                var isMap = v === 'map';
                listView.hidden = isMap;
                mapView.hidden = !isMap;
                if (isMap) initMap(); else {
                    grid.classList.toggle('is-list', v === 'list');
                    grid.querySelectorAll('.venue-col').forEach(function (c) {
                        c.className = (v === 'list' ? 'col-12 venue-col' : 'col-md-6 col-lg-4 venue-col') + (c.classList.contains('is-visible') ? ' is-visible' : '');
                    });
                }
                btns.forEach(function (b) { b.classList.toggle('active', b.dataset.view === v); });
                try { localStorage.setItem('sb.view', v); } catch (e) { }
            }
            btns.forEach(function (b) { b.addEventListener('click', function () { setView(b.dataset.view); }); });

            // ===== Bản đồ (Leaflet + OpenStreetMap, chỉ tải khi cần) =====
            var map = null, markers = {}, userMarker = null;
            var data = [];
            try { data = JSON.parse(document.getElementById('mapData').textContent || '[]'); } catch (e) { }
            var totalCount = @totalCount;
            var detailUrl = '@Url.Action("FacilityDetail", "Booking")/';
            var matrixUrl = '@Url.Action("Matrix", "Booking")?courtId=';
            var fmt = function (n) { return Number(n).toLocaleString('vi-VN'); };
            function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }

            function loadLeaflet(cb) {
                if (window.L) return cb();
                var css = document.createElement('link');
                css.rel = 'stylesheet';
                css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                css.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
                css.crossOrigin = '';
                document.head.appendChild(css);
                var js = document.createElement('script');
                js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                js.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
                js.crossOrigin = '';
                js.onload = cb;
                js.onerror = function () { document.getElementById('venueMap').innerHTML = '<div class="empty-state"><p>Không tải được bản đồ. Vui lòng kiểm tra kết nối mạng.</p></div>'; };
                document.head.appendChild(js);
            }

            function pinIcon(active) {
                return L.divIcon({ className: 'map-pin' + (active ? ' active' : ''), html: '<span><i class="bi bi-geo-alt-fill"></i></span>', iconSize: [34, 42], iconAnchor: [17, 40], popupAnchor: [0, -36] });
            }

            function distanceKm(a, b) {
                var R = 6371, dLat = (b.lat - a.lat) * Math.PI / 180, dLng = (b.lng - a.lng) * Math.PI / 180;
                var x = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * Math.PI / 180) * Math.cos(b.lat * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
                return 2 * R * Math.asin(Math.sqrt(x));
            }

            function renderList(origin) {
                var listEl = document.getElementById('mapList');
                var items = data.slice();
                if (origin) {
                    items.forEach(function (d) { d.km = distanceKm(origin, d); });
                    items.sort(function (a, b) { return a.km - b.km; });
                }
                listEl.innerHTML = items.map(function (d) {
                    return '<button type="button" class="map-item" data-id="' + d.id + '">' +
                        '<div class="fw-bold text-ink text-truncate">' + esc(d.name) + '</div>' +
                        '<div class="small text-muted text-truncate"><i class="bi bi-geo-alt me-1"></i>' + esc(d.addr) + '</div>' +
                        '<div class="d-flex justify-content-between align-items-center mt-1 small">' +
                        '<span class="price" style="font-size:.9rem">' + fmt(d.price) + 'đ<small>/giờ</small></span>' +
                        (d.km != null ? '<span class="badge-soft info"><i class="bi bi-signpost"></i> ' + d.km.toFixed(1) + ' km</span>'
                            : (d.rating ? '<span class="rating-inline"><i class="bi bi-star-fill"></i> ' + Number(d.rating).toFixed(1) + '</span>' : '')) +
                        '</div></button>';
                }).join('') || '<div class="p-3 small text-muted">Không có sân nào có tọa độ để hiển thị.</div>';
                listEl.querySelectorAll('.map-item').forEach(function (el) {
                    el.addEventListener('click', function () { focusVenue(+el.dataset.id); });
                });
            }

            function focusVenue(id) {
                var m = markers[id];
                if (!m) return;
                Object.keys(markers).forEach(function (k) { markers[k].setIcon(pinIcon(+k === id)); });
                map.flyTo(m.getLatLng(), Math.max(map.getZoom(), 15), { duration: .6 });
                m.openPopup();
                document.querySelectorAll('.map-item').forEach(function (el) { el.classList.toggle('active', +el.dataset.id === id); });
            }

            function initMap() {
                if (map) { setTimeout(function () { map.invalidateSize(); }, 50); return; }
                var missing = totalCount - data.length;
                document.getElementById('mapNote').textContent = 'Hiển thị ' + data.length + ' cụm sân trên bản đồ' + (missing > 0 ? ' · ' + missing + ' sân chưa có tọa độ' : '');
                loadLeaflet(function () {
                    map = L.map('venueMap', { scrollWheelZoom: false }).setView([16.05, 106.5], 6);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19, attribution: '&copy; OpenStreetMap'
                    }).addTo(map);
                    map.on('focus', function () { map.scrollWheelZoom.enable(); });
                    var bounds = [];
                    data.forEach(function (d) {
                        var m = L.marker([d.lat, d.lng], { icon: pinIcon(false), title: d.name }).addTo(map);
                        m.bindPopup(
                            '<div class="map-popup"><div class="small text-muted">' + esc(d.sport) + '</div>' +
                            '<div class="fw-bold mb-1">' + esc(d.name) + '</div>' +
                            '<div class="small text-muted mb-2">' + esc(d.addr) + '</div>' +
                            '<div class="d-flex gap-2 align-items-center justify-content-between">' +
                            '<span class="price" style="font-size:.95rem">' + fmt(d.price) + 'đ</span>' +
                            '<span class="d-flex gap-1"><a class="btn btn-light btn-sm" href="' + detailUrl + d.id + '">Chi tiết</a>' +
                            (d.courtId > 0 ? '<a class="btn btn-primary btn-sm" href="' + matrixUrl + d.courtId + '">Đặt sân</a>' : '') +
                            '</span></div></div>'
                        );
                        m.on('click', function () { focusVenue(d.id); });
                        markers[d.id] = m;
                        bounds.push([d.lat, d.lng]);
                    });
                    if (bounds.length === 1) map.setView(bounds[0], 15);
                    else if (bounds.length > 1) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
                    renderList(null);
                });
            }

            var btnLocate = document.getElementById('btnLocate');
            if (btnLocate) btnLocate.addEventListener('click', function () {
                if (!navigator.geolocation) { window.sbToast && sbToast('Trình duyệt không hỗ trợ định vị', 'bi-exclamation-circle-fill'); return; }
                btnLocate.classList.add('is-loading');
                navigator.geolocation.getCurrentPosition(function (pos) {
                    btnLocate.classList.remove('is-loading');
                    var me = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                    if (!map) return;
                    if (userMarker) userMarker.setLatLng([me.lat, me.lng]);
                    else userMarker = L.circleMarker([me.lat, me.lng], { radius: 8, color: '#fff', weight: 3, fillColor: '#0284c7', fillOpacity: 1 }).addTo(map).bindTooltip('Bạn đang ở đây');
                    renderList(me);
                    var nearest = data.slice().sort(function (a, b) { return a.km - b.km; })[0];
                    if (nearest) map.fitBounds([[me.lat, me.lng], [nearest.lat, nearest.lng]], { padding: [60, 60], maxZoom: 15 });
                    else map.setView([me.lat, me.lng], 14);
                    window.sbToast && sbToast('Đã sắp xếp sân theo khoảng cách gần bạn', 'bi-geo-alt-fill');
                }, function () {
                    btnLocate.classList.remove('is-loading');
                    window.sbToast && sbToast('Không lấy được vị trí. Hãy cho phép truy cập vị trí.', 'bi-exclamation-circle-fill');
                }, { enableHighAccuracy: true, timeout: 10000 });
            });

            try { var saved = new URLSearchParams(location.search).get('view') || localStorage.getItem('sb.view'); if (saved === 'list' || saved === 'map') setView(saved); } catch (e) { }
        })();
    </script>
}
