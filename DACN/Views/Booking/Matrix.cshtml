@model DACN.Models.ViewModels.CourtScheduleMatrixViewModel
@using DACN.Models.DTOs
@{
    ViewData["Title"] = $"{Model.CourtName} · {Model.FacilityName}";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var vi = new System.Globalization.CultureInfo("vi-VN");
    var isAuth = User.Identity?.IsAuthenticated == true;
    var returnUrl = Url.Action("Matrix", "Booking", new { courtId = Model.CourtId, date = Model.SelectedDate.ToString("yyyy-MM-dd") });
    int availableCount = Model.Slots.Count(s => s.Availability == SlotAvailability.Available);
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Booking" asp-action="Index">Tìm sân</a></li>
                <li class="breadcrumb-item"><a asp-action="FacilityDetail" asp-route-id="@Model.FacilityId">@Model.FacilityName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.CourtName</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div class="min-w-0">
                <div class="d-flex gap-2 mb-2">
                    <span class="badge-soft success"><i class="bi bi-tag"></i> @Model.SportTypeName</span>
                    <span class="badge-soft info"><i class="bi bi-shield-check"></i> Chống trùng lịch</span>
                </div>
                <h1>@Model.CourtName <span class="text-muted fw-semibold">· @Model.FacilityName</span></h1>
                <p class="sub"><i class="bi bi-geo-alt me-1"></i>@Model.FacilityAddress</p>
            </div>
            @if (Model.OtherCourtsInFacility.Count > 1)
            {
                <div>
                    <label class="form-label small mb-1">Đổi sân</label>
                    <select class="form-select" onchange="location = this.value;" aria-label="Đổi sân">
                        @foreach (var c in Model.OtherCourtsInFacility)
                        {
                            <option value="@Url.Action("Matrix", "Booking", new { courtId = c.Id, date = Model.SelectedDate.ToString("yyyy-MM-dd") })"
                                    selected="@(c.Id == Model.CourtId ? "selected" : null)">@c.Name</option>
                        }
                    </select>
                </div>
            }
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4">
        <!-- Slot grid -->
        <div class="col-lg-8">
            <div class="panel mb-4">
                <div class="panel-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div class="fw-bold text-ink"><i class="bi bi-calendar3 text-success me-2"></i>Chọn ngày</div>
                        <form method="get" asp-action="Matrix" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="courtId" value="@Model.CourtId" />
                            <input type="date" name="date" class="form-control form-control-sm" style="max-width: 160px;"
                                   min="@today.ToString("yyyy-MM-dd")" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" aria-label="Chọn ngày khác" />
                        </form>
                    </div>
                    <div class="date-strip">
                        @for (int i = 0; i < 14; i++)
                        {
                            var d = today.AddDays(i);
                            <a asp-action="Matrix" asp-route-courtId="@Model.CourtId" asp-route-date="@d.ToString("yyyy-MM-dd")" class="date-pill @(d == Model.SelectedDate ? "active" : "")">
                                <div class="dow">@(i == 0 ? "Hôm nay" : d.ToString("ddd", vi))</div>
                                <div class="day">@d.Day</div>
                                <div class="dow" style="font-size:.65rem">Th@(d.Month)</div>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <h5 class="panel-title"><i class="bi bi-clock"></i> Khung giờ ngày @Model.SelectedDate.ToString("dd/MM/yyyy")</h5>
                    <div class="d-flex flex-wrap gap-3 small text-muted">
                        <span><span class="legend-dot" style="border-color:var(--brand-200);background:#fff"></span> Trống</span>
                        <span><span class="legend-dot" style="border-color:var(--brand);background:var(--brand)"></span> Đang chọn</span>
                        <span><span class="legend-dot" style="border-color:#fde68a;background:#fffbeb"></span> Đang giữ</span>
                        <span><span class="legend-dot" style="border-color:var(--line);background:var(--line-2)"></span> Đã đặt / đã qua</span>
                    </div>
                </div>
                <div class="panel-body">
                    @if (!Model.Slots.Any())
                    {
                        <div class="empty-state py-4">
                            <span class="icon-bubble lg slate"><i class="bi bi-calendar-x"></i></span>
                            <h5>Sân chưa có bảng giá</h5>
                            <p class="mb-0">Chủ sân chưa thiết lập khung giờ cho sân này.</p>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-3"><strong class="text-success">@availableCount</strong> khung giờ còn trống · bấm 1 ô để chọn, bấm thêm ô liền kề để đặt nhiều giờ liên tiếp</div>
                        <div class="matrix-container">
                            @foreach (var slot in Model.Slots)
                            {
                                var isAvailable = slot.Availability == SlotAvailability.Available;
                                var cls = slot.Availability switch
                                {
                                    SlotAvailability.Available => "slot-available",
                                    SlotAvailability.Booked => "slot-booked",
                                    SlotAvailability.PendingPayment => "slot-holding",
                                    _ => "slot-past"
                                };
                                var status = slot.Availability switch
                                {
                                    SlotAvailability.Available => "",
                                    SlotAvailability.Booked => "Đã đặt",
                                    SlotAvailability.PendingPayment => "Đang giữ",
                                    _ => "Đã qua"
                                };
                                <div class="matrix-slot-card @cls"
                                     data-slot-index="@slot.SlotIndex"
                                     data-start="@DACN.Services.BookingRules.Hm(slot.StartTime)"
                                     data-end="@DACN.Services.BookingRules.Hm(slot.EndTime)"
                                     data-price="@slot.Price"
                                     data-available="@isAvailable.ToString().ToLower()"
                                     tabindex="@(isAvailable ? "0" : null)" role="@(isAvailable ? "button" : null)">
                                    <div class="slot-time">@slot.TimeLabel</div>
                                    <div class="slot-price">@if (slot.IsPeakHour && isAvailable) {<i class="bi bi-lightning-charge-fill text-warning me-1" title="Giờ cao điểm"></i>}@(isAvailable ? $"{slot.Price:N0}đ" : status)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Booking summary -->
        <div class="col-lg-4">
            <div class="panel sticky-side">
                <div class="panel-header"><h5 class="panel-title"><i class="bi bi-receipt"></i> Thông tin đặt sân</h5></div>
                <div class="panel-body">
                    <form asp-action="Create" method="post" id="bookingForm">
                        <input type="hidden" name="CourtId" value="@Model.CourtId" />
                        <input type="hidden" name="BookingDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="bookingDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="StartTime" id="inputStartTime" value="" />
                        <input type="hidden" name="EndTime" id="inputEndTime" value="" />
                        <input type="hidden" name="startTime" id="fallbackStartTime" value="" />
                        <input type="hidden" name="endTime" id="fallbackEndTime" value="" />

                        <div class="summary-row"><span class="k">Sân</span><span class="v">@Model.CourtName</span></div>
                        <div class="summary-row"><span class="k">Ngày</span><span class="v">@Model.SelectedDate.ToString("dddd, dd/MM/yyyy", vi)</span></div>
                        <div class="summary-row"><span class="k">Khung giờ</span><span class="v" id="selectedSlotText"><span class="text-muted fw-normal">Chưa chọn</span></span></div>

                        @if (isAuth)
                        {
                            <div class="mt-3">
                                <label class="form-label" for="inputCustomerName">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="CustomerName" id="inputCustomerName" class="form-control" placeholder="VD: Nguyễn Văn An" required
                                       value="@(ViewBag.CurrentUserFullName ?? "")" />
                            </div>
                            <div class="mt-2">
                                <label class="form-label" for="inputCustomerPhone">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" name="CustomerPhone" id="inputCustomerPhone" class="form-control" placeholder="VD: 0912345678" required pattern="[0-9]{9,12}"
                                       value="@(ViewBag.CurrentUserPhone ?? "")" />
                            </div>

                            @if (Model.AvailableServices != null && Model.AvailableServices.Any())
                            {
                                <div class="mt-3">
                                    <label class="form-label">Dịch vụ thêm</label>
                                    <div class="border rounded-3 p-2">
                                        @foreach (var s in Model.AvailableServices)
                                        {
                                            <div class="form-check d-flex justify-content-between align-items-center py-1">
                                                <div>
                                                    <input class="form-check-input service-check" type="checkbox" name="SelectedServiceIds" value="@s.Id" data-price="@s.Price" id="svc-@s.Id">
                                                    <label class="form-check-label small ms-1" for="svc-@s.Id">@s.Name</label>
                                                </div>
                                                <span class="small text-muted">+@s.Price.ToString("N0")đ</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="mt-3">
                                <label class="form-label" for="noteInput">Ghi chú <span class="text-muted fw-normal">(tùy chọn)</span></label>
                                <textarea name="Note" id="noteInput" class="form-control" rows="2" placeholder="VD: Cần mượn áo pitch, bóng..."></textarea>
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-3 rounded-3 my-3" style="background: var(--brand-50); border: 1px solid var(--brand-100);">
                                <span class="fw-semibold text-ink">Tổng tiền</span>
                                <span class="price fs-4" id="totalPriceDisplay">0đ</span>
                            </div>

                            <div id="bookingFormError" class="alert alert-danger py-2 small d-none"></div>

                            <button type="submit" id="btnSubmitBooking" class="btn btn-primary btn-lg w-100" disabled>
                                <i class="bi bi-lightning-charge-fill me-1"></i> Giữ chỗ &amp; thanh toán
                            </button>
                            <div class="small text-muted text-center mt-2"><i class="bi bi-hourglass-split me-1"></i>Khung giờ được giữ trong thời gian thanh toán</div>
                        }
                        else
                        {
                            <div class="alert alert-info small mt-3 mb-3"><i class="bi bi-info-circle me-1"></i>Bạn cần đăng nhập để giữ chỗ và thanh toán.</div>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="btn btn-primary w-100 mb-2">Đăng nhập để đặt sân</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-light w-100">Tạo tài khoản mới</a>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const slotCards = document.querySelectorAll('.slot-available');
            const inputStartTime = document.getElementById('inputStartTime');
            const inputEndTime = document.getElementById('inputEndTime');
            const fallbackStartTime = document.getElementById('fallbackStartTime');
            const fallbackEndTime = document.getElementById('fallbackEndTime');
            const selectedSlotText = document.getElementById('selectedSlotText');
            const totalPriceDisplay = document.getElementById('totalPriceDisplay');
            const btnSubmitBooking = document.getElementById('btnSubmitBooking');
            const serviceChecks = document.querySelectorAll('.service-check');
            const bookingForm = document.getElementById('bookingForm');
            const errorBox = document.getElementById('bookingFormError');
            let currentSlotPrice = 0;

            function calculateGrandTotal() {
                if (!totalPriceDisplay) return;
                let servicesTotal = 0;
                serviceChecks.forEach(chk => { if (chk.checked) servicesTotal += parseFloat(chk.getAttribute('data-price') || 0); });
                totalPriceDisplay.textContent = (currentSlotPrice + servicesTotal).toLocaleString('vi-VN') + 'đ';
            }
            serviceChecks.forEach(chk => chk.addEventListener('change', calculateGrandTotal));

            // ===== Chọn nhiều giờ liên tiếp: bấm ô đầu rồi bấm ô cuối (hoặc bấm từng ô kế tiếp) =====
            const MAX_SLOTS = 6;
            const allCards = Array.from(document.querySelectorAll('.matrix-slot-card'));
            let range = null; // { from, to } là chỉ số trong allCards

            function isContiguousAvailable(from, to) {
                for (let i = from; i <= to; i++) {
                    if (allCards[i].dataset.available !== 'true') return false;
                    if (i > from && allCards[i - 1].dataset.end !== allCards[i].dataset.start) return false;
                }
                return true;
            }

            function render() {
                allCards.forEach(c => c.classList.remove('slot-selected'));
                if (!range) {
                    currentSlotPrice = 0;
                    inputStartTime.value = inputEndTime.value = '';
                    if (fallbackStartTime) fallbackStartTime.value = '';
                    if (fallbackEndTime) fallbackEndTime.value = '';
                    selectedSlotText.innerHTML = '<span class="text-muted fw-normal">Chưa chọn</span>';
                    if (btnSubmitBooking) btnSubmitBooking.setAttribute('disabled', 'disabled');
                    calculateGrandTotal();
                    return;
                }
                currentSlotPrice = 0;
                for (let i = range.from; i <= range.to; i++) {
                    allCards[i].classList.add('slot-selected');
                    currentSlotPrice += parseFloat(allCards[i].dataset.price || 0);
                }
                const start = allCards[range.from].dataset.start;
                const end = allCards[range.to].dataset.end;
                const hours = range.to - range.from + 1;
                inputStartTime.value = start;
                inputEndTime.value = end;
                if (fallbackStartTime) fallbackStartTime.value = start;
                if (fallbackEndTime) fallbackEndTime.value = end;
                selectedSlotText.innerHTML = '<span class="text-success fw-bold">' + start + ' – ' + end + '</span>'
                    + ' <span class="text-muted fw-normal small">(' + hours + ' khung)</span>';
                calculateGrandTotal();
                if (btnSubmitBooking) btnSubmitBooking.removeAttribute('disabled');
                if (errorBox) errorBox.classList.add('d-none');
            }

            function selectSlot(card) {
                const idx = allCards.indexOf(card);
                if (!range) {
                    range = { from: idx, to: idx };
                } else if (idx > range.to && isContiguousAvailable(range.from, idx)) {
                    range.to = idx;                                   // kéo dài về phía sau
                } else if (idx < range.from && isContiguousAvailable(idx, range.to)) {
                    range.from = idx;                                 // kéo dài về phía trước
                } else if ((idx === range.to || idx === range.from) && range.to > range.from) {
                    if (idx === range.to) range.to--; else range.from++; // bỏ bớt ô ở đầu / cuối
                } else if (idx === range.from && idx === range.to) {
                    range = null;                                     // bấm lại ô duy nhất = bỏ chọn
                } else {
                    range = { from: idx, to: idx };                   // không liền kề -> chọn lại từ đầu
                }
                if (range && range.to - range.from + 1 > MAX_SLOTS) {
                    if (idx === range.to) range.from = range.to - MAX_SLOTS + 1; else range.to = range.from + MAX_SLOTS - 1;
                    showError('Mỗi đơn đặt tối đa ' + MAX_SLOTS + ' khung giờ liên tiếp.');
                    render();
                    errorBox && errorBox.classList.remove('d-none');
                    return;
                }
                render();
            }

            slotCards.forEach(card => {
                card.addEventListener('click', function () { selectSlot(this); });
                card.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSlot(this); } });
            });

            function showError(msg, focusEl) {
                if (errorBox) { errorBox.textContent = msg; errorBox.classList.remove('d-none'); }
                if (focusEl) focusEl.focus();
            }

            if (bookingForm && btnSubmitBooking) {
                bookingForm.addEventListener('submit', function (e) {
                    const nameInput = document.getElementById('inputCustomerName');
                    const phoneInput = document.getElementById('inputCustomerPhone');
                    if (!inputStartTime.value || !inputEndTime.value) { e.preventDefault(); return showError('Vui lòng chọn ít nhất một khung giờ trống.'); }
                    if (!nameInput.value.trim()) { e.preventDefault(); return showError('Vui lòng nhập họ và tên người đặt.', nameInput); }
                    if (!phoneInput.value.trim()) { e.preventDefault(); return showError('Vui lòng nhập số điện thoại.', phoneInput); }
                    btnSubmitBooking.disabled = true;
                    btnSubmitBooking.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang giữ chỗ...';
                });
            }
        });
    </script>
}
