@model DACN.Models.ViewModels.CourtScheduleMatrixViewModel
@{
    ViewData["Title"] = $"Lịch đặt sân - {Model.CourtName} | {Model.FacilityName}";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var tomorrow = today.AddDays(1);
    var dayAfter = today.AddDays(2);
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Booking" asp-action="Index">Tìm sân</a></li>
            <li class="breadcrumb-item"><a asp-action="FacilityDetail" asp-route-id="@Model.FacilityId">@Model.FacilityName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.CourtName</li>
        </ol>
    </nav>

    <!-- Error / Success Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow" role="alert" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5;">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Facility Info Card -->
    <div class="card shadow-lg border-0 mb-4 rounded-4" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary fs-6 px-3 py-1 rounded-pill">
                            <i class="bi bi-tag-fill me-1"></i> @Model.SportTypeName
                        </span>
                        <span class="badge bg-success-subtle text-success fs-6 px-3 py-1 rounded-pill">
                            <i class="bi bi-shield-check me-1"></i> Chống trùng lịch tức thì (Serializable)
                        </span>
                    </div>
                    <h2 class="fw-bold mb-1 text-white">@Model.CourtName - @Model.FacilityName</h2>
                    <p class="text-white-50 mb-0">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.FacilityAddress
                    </p>
                </div>

                <!-- Court switcher -->
                @if (Model.OtherCourtsInFacility.Any())
                {
                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <label class="fw-semibold text-white-50 small text-nowrap"><i class="bi bi-arrow-left-right me-1 text-info"></i> Đổi sân:</label>
                        <select class="form-select form-select-sm w-auto text-white border-secondary border-opacity-50" style="background: #1e293b;" onchange="location = this.value;">
                            @foreach (var c in Model.OtherCourtsInFacility)
                            {
                                <option value="@Url.Action("Matrix", "Booking", new { courtId = c.Id, date = Model.SelectedDate.ToString("yyyy-MM-dd") })"
                                        selected="@(c.Id == Model.CourtId ? "selected" : null)">
                                    @c.Name
                                </option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Date Selection Chips & Status Legend -->
    <div class="card shadow-lg border-0 mb-4 rounded-4" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-lg-7">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-white-50 small fw-bold me-1"><i class="bi bi-calendar3 text-primary"></i> Ngày đá:</span>
                        
                        <a asp-action="Matrix" asp-route-courtId="@Model.CourtId" asp-route-date="@today.ToString("yyyy-MM-dd")"
                           class="btn btn-sm @(Model.SelectedDate == today ? "btn-primary fw-bold shadow" : "btn-outline-secondary text-white-50") rounded-pill px-3">
                            Hôm nay (@today.ToString("dd/MM"))
                        </a>

                        <a asp-action="Matrix" asp-route-courtId="@Model.CourtId" asp-route-date="@tomorrow.ToString("yyyy-MM-dd")"
                           class="btn btn-sm @(Model.SelectedDate == tomorrow ? "btn-primary fw-bold shadow" : "btn-outline-secondary text-white-50") rounded-pill px-3">
                            Ngày mai (@tomorrow.ToString("dd/MM"))
                        </a>

                        <a asp-action="Matrix" asp-route-courtId="@Model.CourtId" asp-route-date="@dayAfter.ToString("yyyy-MM-dd")"
                           class="btn btn-sm @(Model.SelectedDate == dayAfter ? "btn-primary fw-bold shadow" : "btn-outline-secondary text-white-50") rounded-pill px-3">
                            Ngày kia (@dayAfter.ToString("dd/MM"))
                        </a>

                        <!-- Custom Date Picker -->
                        <form method="get" asp-action="Matrix" class="d-inline-flex align-items-center ms-auto">
                            <input type="hidden" name="courtId" value="@Model.CourtId" />
                            <input type="date" name="date" class="form-control form-control-sm text-white" style="max-width: 145px; background: #1e293b; border-color: rgba(255,255,255,0.2);"
                                   value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                        </form>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="d-flex flex-wrap justify-content-lg-end gap-3 small text-white-50">
                        <div class="d-flex align-items-center">
                            <span class="d-inline-block rounded me-1 bg-success-subtle border border-success" style="width: 14px; height: 14px;"></span>
                            <span>Trống</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="d-inline-block rounded me-1 bg-primary" style="width: 14px; height: 14px;"></span>
                            <span>Đang chọn</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="d-inline-block rounded me-1 bg-danger" style="width: 14px; height: 14px;"></span>
                            <span>Đã đặt</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="d-inline-block rounded me-1 bg-warning" style="width: 14px; height: 14px;"></span>
                            <span>Giữ chỗ</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="d-inline-block rounded me-1 bg-secondary bg-opacity-25" style="width: 14px; height: 14px;"></span>
                            <span>Đã qua</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Booking Matrix Layout -->
    <div class="row g-4">
        <!-- Grid ma trận khung giờ (Timeline Slots) -->
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-header py-3 px-4 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center" style="background: #1f2937;">
                    <h5 class="fw-bold mb-0 text-white">
                        <i class="bi bi-clock-history text-primary me-2"></i> Lịch trống ngày @Model.SelectedDate.ToString("dddd, dd/MM/yyyy")
                    </h5>
                    <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-hand-index-thumb me-1"></i> Bấm ô để chọn giờ
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        @foreach (var slot in Model.Slots)
                        {
                            var isAvailable = slot.Availability == DACN.Models.DTOs.SlotAvailability.Available;
                            var isBooked = slot.Availability == DACN.Models.DTOs.SlotAvailability.Booked;
                            var isPending = slot.Availability == DACN.Models.DTOs.SlotAvailability.PendingPayment;
                            var isPast = slot.Availability == DACN.Models.DTOs.SlotAvailability.PastTime;

                            string cardClass = "slot-past opacity-50";
                            string statusBadge = "<span class='badge bg-secondary'>Đã qua</span>";

                            if (isAvailable)
                            {
                                cardClass = "slot-available cursor-pointer";
                                statusBadge = "<span class='badge bg-success-subtle text-success'>Còn trống</span>";
                            }
                            else if (isBooked)
                            {
                                cardClass = "slot-booked";
                                statusBadge = "<span class='badge bg-danger'>Đã đặt</span>";
                            }
                            else if (isPending)
                            {
                                cardClass = "slot-pending";
                                statusBadge = "<span class='badge bg-warning text-dark'>Chờ thanh toán</span>";
                            }

                            <div class="col-6 col-sm-4 col-md-3">
                                <div class="card h-100 p-3 text-center slot-card @cardClass"
                                     data-slot-index="@slot.SlotIndex"
                                     data-start="@slot.StartTime.ToString(@"hh\:mm")"
                                     data-end="@slot.EndTime.ToString(@"hh\:mm")"
                                     data-price="@slot.Price"
                                     data-available="@isAvailable.ToString().ToLower()">
                                    
                                    <div class="fw-bold fs-6 mb-1 text-white">
                                        <i class="bi bi-clock me-1 text-primary"></i>@slot.TimeLabel
                                    </div>
                                    <div class="text-danger fw-bold fs-6 my-1">@slot.Price.ToString("N0") đ</div>
                                    
                                    @if (slot.IsPeakHour)
                                    {
                                        <div class="mb-1">
                                            <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">
                                                <i class="bi bi-fire text-danger"></i> Giờ vàng
                                            </span>
                                        </div>
                                    }

                                    <div class="mt-auto pt-1">@Html.Raw(statusBadge)</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Xác nhận & Đặt sân -->
        <div class="col-lg-4">
            <div class="card shadow-lg border-0 rounded-4 sticky-top" style="top: 80px; z-index: 10; background: #111827; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-header py-3 px-4 border-bottom border-secondary border-opacity-25" style="background: #1f2937;">
                    <h5 class="fw-bold mb-0 text-white"><i class="bi bi-cart-check text-warning me-2"></i> Chi Tiết Lựa Chọn</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="bookingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CourtId" value="@Model.CourtId" />
                        <input type="hidden" name="BookingDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="bookingDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="CustomerId" value="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "demo-customer-id")" />
                        <input type="hidden" name="StartTime" id="inputStartTime" value="" />
                        <input type="hidden" name="EndTime" id="inputEndTime" value="" />
                        <input type="hidden" name="startTime" id="fallbackStartTime" value="" />
                        <input type="hidden" name="endTime" id="fallbackEndTime" value="" />

                        <div class="mb-2">
                            <label class="form-label text-white-50 small mb-1">Cơ sở:</label>
                            <div class="fw-bold text-white">@Model.FacilityName</div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-white-50 small mb-1">Sân thi đấu:</label>
                            <div class="fw-bold text-success">@Model.CourtName (@Model.SportTypeName)</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white-50 small mb-1">Ngày thi đấu:</label>
                            <div class="fw-bold text-white">@Model.SelectedDate.ToString("dddd, dd/MM/yyyy")</div>
                        </div>

                        <hr class="my-3 border-secondary border-opacity-25" />

                        <div class="mb-3">
                            <label class="form-label text-white-50 small mb-1">Khung giờ chọn:</label>
                            <div id="selectedSlotText" class="alert py-2 px-3 mb-0 text-center text-white-50 rounded-3" style="background: rgba(255, 255, 255, 0.05); border: 1px dashed rgba(255, 255, 255, 0.2);">
                                <em>Vui lòng nhấp chọn 1 khung giờ trống bên cạnh</em>
                            </div>
                        </div>

                        <!-- Customer Name and Phone (Required) -->
                        <div class="mb-3 p-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <div class="fw-bold text-white small mb-2 d-flex align-items-center gap-1">
                                <i class="bi bi-person-lines-fill text-info"></i> Thông tin người đặt sân <span class="text-danger">*</span>
                            </div>
                            <div class="mb-2">
                                <label class="form-label text-white-50 small mb-1">Họ và tên người đặt (*):</label>
                                <input type="text" name="CustomerName" id="inputCustomerName" class="form-control form-control-sm text-white" 
                                       placeholder="VD: Nguyễn Văn An" required 
                                       value="@(ViewBag.CurrentUserFullName ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : ""))" 
                                       style="background: #1e293b; border-color: rgba(255, 255, 255, 0.2);" />
                            </div>
                            <div>
                                <label class="form-label text-white-50 small mb-1">Số điện thoại liên hệ (*):</label>
                                <input type="tel" name="CustomerPhone" id="inputCustomerPhone" class="form-control form-control-sm text-white" 
                                       placeholder="VD: 0912345678" required pattern="[0-9]{9,12}" 
                                       value="@(ViewBag.CurrentUserPhone ?? "")" 
                                       style="background: #1e293b; border-color: rgba(255, 255, 255, 0.2);" />
                            </div>
                        </div>

                        <!-- Add-on Services Selection -->
                        @if (Model.AvailableServices != null && Model.AvailableServices.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label text-white small mb-1 fw-bold">
                                    <i class="bi bi-bag-plus text-info me-1"></i> Dịch vụ & Tiện ích đi kèm:
                                </label>
                                <div class="p-2 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                                    @foreach (var s in Model.AvailableServices)
                                    {
                                        <div class="form-check d-flex justify-content-between align-items-center mb-1">
                                            <div>
                                                <input class="form-check-input service-check" type="checkbox" name="SelectedServiceIds" value="@s.Id" data-price="@s.Price" id="svc-@s.Id">
                                                <label class="form-check-label small ms-1 cursor-pointer text-white-50" for="svc-@s.Id">
                                                    @s.Name
                                                </label>
                                            </div>
                                            <span class="badge bg-dark text-warning border border-warning border-opacity-25">+@s.Price.ToString("N0") đ</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="p-3 rounded-3 mb-3 d-flex justify-content-between align-items-center" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3);">
                            <span class="text-white small">Tổng tiền:</span>
                            <div class="fs-4 fw-bold text-danger" id="totalPriceDisplay">0 VNĐ</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white-50 small mb-1">Ghi chú cho sân (tùy chọn):</label>
                            <textarea name="Note" class="form-control text-white" rows="2" placeholder="VD: Mượn áo pitch thi đấu, mượn bóng..." style="background: #1e293b; border-color: rgba(255,255,255,0.2);"></textarea>
                        </div>

                        <button type="submit" id="btnSubmitBooking" class="btn btn-sport-gradient btn-lg w-100 shadow rounded-pill fw-bold" disabled>
                            <i class="bi bi-lightning-charge-fill me-1"></i> Giữ Chỗ & Thanh Toán Ngay
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cursor-pointer {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .slot-card {
        border-radius: 12px;
        transition: all 0.2s ease-in-out;
    }
    .slot-available {
        background: #0f172a;
        border: 1px solid rgba(16, 185, 129, 0.4);
    }
    .slot-available:hover {
        transform: translateY(-3px);
        border-color: #10b981 !important;
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.3) !important;
    }
    .slot-booked {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .slot-pending {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .slot-past {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .slot-selected {
        background: linear-gradient(135deg, #0ea5e9, #0284c7) !important;
        color: #ffffff !important;
        border-color: #38bdf8 !important;
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(14, 165, 233, 0.5) !important;
    }
    .slot-selected .text-white,
    .slot-selected .text-danger,
    .slot-selected .text-primary,
    .slot-selected .badge {
        color: #ffffff !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const slotCards = document.querySelectorAll('.slot-available');
            const inputStartTime = document.getElementById('inputStartTime');
            const inputEndTime = document.getElementById('inputEndTime');
            const fallbackStartTime = document.getElementById('fallbackStartTime');
            const fallbackEndTime = document.getElementById('fallbackEndTime');
            const selectedSlotText = document.getElementById('selectedSlotText');
            const totalPriceDisplay = document.getElementById('totalPriceDisplay');
            const btnSubmitBooking = document.getElementById('btnSubmitBooking');
            const serviceChecks = document.querySelectorAll('.service-check');
            const bookingForm = document.getElementById('bookingForm');

            let currentSlotPrice = 0;

            function calculateGrandTotal() {
                let servicesTotal = 0;
                serviceChecks.forEach(chk => {
                    if (chk.checked) {
                        servicesTotal += parseFloat(chk.getAttribute('data-price') || 0);
                    }
                });
                const total = currentSlotPrice + servicesTotal;
                totalPriceDisplay.textContent = total.toLocaleString('vi-VN') + ' VNĐ';
            }

            serviceChecks.forEach(chk => {
                chk.addEventListener('change', calculateGrandTotal);
            });

            slotCards.forEach(card => {
                card.addEventListener('click', function () {
                    // Deselect other slots
                    slotCards.forEach(c => c.classList.remove('slot-selected'));

                    // Mark current slot
                    this.classList.add('slot-selected');

                    const start = this.getAttribute('data-start');
                    const end = this.getAttribute('data-end');
                    currentSlotPrice = parseFloat(this.getAttribute('data-price') || 0);

                    inputStartTime.value = start;
                    inputEndTime.value = end;
                    if (fallbackStartTime) fallbackStartTime.value = start;
                    if (fallbackEndTime) fallbackEndTime.value = end;

                    selectedSlotText.classList.remove('text-white-50');
                    selectedSlotText.style.background = 'rgba(14, 165, 233, 0.15)';
                    selectedSlotText.style.border = '1px solid rgba(14, 165, 233, 0.5)';
                    selectedSlotText.innerHTML = `<strong class="fs-6 text-info"><i class="bi bi-clock-fill me-1"></i> ${start} - ${end}</strong>`;

                    calculateGrandTotal();

                    btnSubmitBooking.removeAttribute('disabled');
                });
            });

            bookingForm.addEventListener('submit', function (e) {
                if (!inputStartTime.value || !inputEndTime.value) {
                    e.preventDefault();
                    alert('Vui lòng nhấp chọn một khung giờ trống trước khi bấm đặt sân.');
                    return false;
                }

                const nameInput = document.getElementById('inputCustomerName');
                const phoneInput = document.getElementById('inputCustomerPhone');
                if (!nameInput.value.trim()) {
                    e.preventDefault();
                    alert('Vui lòng nhập họ và tên người đặt sân.');
                    nameInput.focus();
                    return false;
                }
                if (!phoneInput.value.trim()) {
                    e.preventDefault();
                    alert('Vui lòng nhập số điện thoại người đặt sân.');
                    phoneInput.focus();
                    return false;
                }
            });
        });
    </script>
}
