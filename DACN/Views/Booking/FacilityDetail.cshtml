@model DACN.Models.Facility
@{
    ViewData["Title"] = Model.Name;
    var coverImg = DACN.Services.FacilityService.GetSportCoverImage(Model.SportType?.Name);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var hasCoordinates = Model.Latitude.HasValue && Model.Longitude.HasValue && Model.Latitude.Value != 0;
    var mapEmbedUrl = hasCoordinates
        ? $"https://maps.google.com/maps?q={Model.Latitude!.Value.ToString(inv)},{Model.Longitude!.Value.ToString(inv)}&hl=vi&z=16&output=embed"
        : $"https://maps.google.com/maps?q={Uri.EscapeDataString(Model.Name + ", " + Model.Address)}&hl=vi&z=16&output=embed";
    var mapDirectionUrl = hasCoordinates
        ? $"https://www.google.com/maps/dir/?api=1&destination={Model.Latitude!.Value.ToString(inv)},{Model.Longitude!.Value.ToString(inv)}"
        : $"https://www.google.com/maps/dir/?api=1&destination={Uri.EscapeDataString(Model.Address)}";

    var reviews = Model.Reviews.OrderByDescending(r => r.CreatedAt).ToList();
    var avg = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
    var allSlots = Model.Courts.SelectMany(c => c.TimeSlots).ToList();
    var minPrice = allSlots.Any() ? allSlots.Min(s => s.Price) : DACN.Services.BookingRules.DefaultPricePerHour;
    var activeCourts = Model.Courts.Where(c => c.IsActive).ToList();
    var now = DateTime.Now.TimeOfDay;
    var isOpen = DACN.Services.BookingRules.OpenSegments(Model).Any(s => now >= s.Start && now < s.End);
}

<!-- Cover -->
<div style="height: 260px; background: linear-gradient(180deg, rgba(15,23,42,.05), rgba(15,23,42,.55)), url('@coverImg') center/cover, #14532d;"></div>

<div class="container" style="margin-top: -90px;">
    <div class="panel p-4 mb-4 position-relative">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Booking" asp-action="Index">Tìm sân</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div class="min-w-0">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge-soft success"><i class="@(Model.SportType?.IconCss ?? "bi bi-activity")"></i> @(Model.SportType?.Name ?? "Thể thao")</span>
                    <span class="badge-soft @(isOpen ? "success" : "neutral")"><span class="status-dot @(isOpen ? "on" : "off")"></span> @(isOpen ? "Đang mở cửa" : "Đã đóng cửa")</span>
                    @if (!string.IsNullOrEmpty(Model.City?.Name))
                    {
                        <span class="badge-soft neutral"><i class="bi bi-geo"></i> @Model.City!.Name</span>
                    }
                </div>
                <h1 class="h2 fw-extrabold mb-2">@Model.Name</h1>
                <div class="text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
                <div class="d-flex flex-wrap align-items-center gap-3 small">
                    @if (reviews.Any())
                    {
                        <a href="#reviews" class="rating-inline"><partial name="_Stars" model="avg" /> @avg.ToString("0.0") <span class="count">(@reviews.Count đánh giá)</span></a>
                    }
                    else
                    {
                        <span class="text-muted"><i class="bi bi-star me-1"></i>Chưa có đánh giá</span>
                    }
                    <span class="text-muted"><i class="bi bi-clock me-1"></i>@DACN.Services.BookingRules.OpenHoursText(Model)</span>
                    <span class="text-muted"><i class="bi bi-grid-3x3-gap me-1"></i>@Model.Courts.Count sân</span>
                </div>
            </div>
            <div class="text-lg-end">
                <div class="small text-muted">Giá chỉ từ</div>
                <div class="price fs-3 mb-2">@minPrice.ToString("N0")đ<small>/giờ</small></div>
                @if (activeCourts.Any())
                {
                    <a asp-action="Matrix" asp-route-courtId="@activeCourts.First().Id" class="btn btn-primary"><i class="bi bi-calendar-check me-1"></i> Xem lịch &amp; đặt sân</a>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Courts -->
            <div class="panel mb-4">
                <div class="panel-header">
                    <h5 class="panel-title"><i class="bi bi-grid-3x3-gap"></i> Chọn sân</h5>
                    <span class="small text-muted">@activeCourts.Count / @Model.Courts.Count sân đang hoạt động</span>
                </div>
                <div class="panel-body">
                    <div class="row g-3">
                        @foreach (var court in Model.Courts)
                        {
                            var slots = court.TimeSlots.OrderBy(s => s.StartTime).ToList();
                            decimal minP = slots.Any() ? slots.Min(s => s.Price) : DACN.Services.BookingRules.DefaultPricePerHour;
                            decimal maxP = slots.Any() ? slots.Max(s => s.Price) : DACN.Services.BookingRules.DefaultPricePerHour;
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 h-100 d-flex flex-column @(court.IsActive ? "" : "bg-light")">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-bold text-ink">@court.Name</div>
                                        <span class="badge-soft @(court.IsActive ? "success" : "neutral")">@(court.IsActive ? "Hoạt động" : "Bảo trì")</span>
                                    </div>
                                    <div class="small text-muted mb-2">
                                        @if (slots.Any(s => s.IsPeakHour))
                                        {
                                            <span><i class="bi bi-lightning-charge text-warning"></i> Có khung giờ cao điểm</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-check2-circle text-success"></i> Giá cố định cả ngày</span>
                                        }
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                        <div class="fw-bold text-accent">
                                            @(minP == maxP ? $"{minP:N0}đ" : $"{minP:N0} – {maxP:N0}đ")<small class="text-muted fw-normal">/giờ</small>
                                        </div>
                                        @if (court.IsActive)
                                        {
                                            <a asp-action="Matrix" asp-route-courtId="@court.Id" class="btn btn-soft btn-sm">Xem lịch trống</a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-light btn-sm" disabled>Tạm ngưng</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- About -->
            <div class="panel mb-4">
                <div class="panel-header"><h5 class="panel-title"><i class="bi bi-info-circle"></i> Giới thiệu</h5></div>
                <div class="panel-body">
                    <p class="mb-3" style="line-height:1.8;">
                        @(string.IsNullOrEmpty(Model.Description)
                            ? "Cụm sân thể thao chất lượng cao, trang bị hệ thống chiếu sáng hiện đại, mặt sân đạt chuẩn, bãi đỗ xe rộng rãi cùng đầy đủ tiện ích phục vụ người chơi."
                            : Model.Description)
                    </p>
                    <div class="row g-2">
                        @foreach (var (icon, text) in new[] { ("bi-lightbulb", "Đèn LED chuẩn thi đấu"), ("bi-p-square", "Bãi giữ xe"), ("bi-cup-hot", "Căng-tin, nước uống"), ("bi-wifi", "Wifi miễn phí"), ("bi-droplet", "Phòng tắm, thay đồ"), ("bi-camera-video", "Camera an ninh") })
                        {
                            <div class="col-6 col-md-4">
                                <div class="d-flex align-items-center gap-2 small p-2 rounded-3" style="background: var(--line-2);">
                                    <i class="bi @icon text-success"></i> @text
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Services -->
            @if (Model.Services.Any(x => x.IsActive))
            {
                <div class="panel mb-4">
                    <div class="panel-header"><h5 class="panel-title"><i class="bi bi-bag-check"></i> Dịch vụ &amp; thuê đồ tại sân</h5></div>
                    <div class="table-wrap">
                        <table class="table">
                            <thead><tr><th>Dịch vụ</th><th>Đơn vị</th><th class="text-end">Đơn giá</th></tr></thead>
                            <tbody>
                                @foreach (var s in Model.Services.Where(x => x.IsActive))
                                {
                                    <tr>
                                        <td class="fw-semibold text-ink">@s.Name</td>
                                        <td class="text-muted">@s.Unit</td>
                                        <td class="text-end fw-bold">@s.Price.ToString("N0")đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Reviews -->
            <div class="panel mb-4" id="reviews">
                <div class="panel-header">
                    <h5 class="panel-title"><i class="bi bi-star"></i> Đánh giá từ người chơi</h5>
                    <a asp-action="MyBookings" asp-route-filter="completed" class="small">Viết đánh giá</a>
                </div>
                <div class="panel-body">
                    @if (!reviews.Any())
                    {
                        <div class="empty-state py-4">
                            <span class="icon-bubble lg amber"><i class="bi bi-star"></i></span>
                            <h5>Chưa có đánh giá</h5>
                            <p class="mb-0">Sau khi chơi xong, bạn có thể đánh giá sân trong mục <strong>Lịch đặt của tôi</strong>.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4 align-items-center mb-2">
                            <div class="col-sm-4 text-center">
                                <div class="display-5 fw-extrabold text-ink lh-1">@avg.ToString("0.0")</div>
                                <div class="my-1 fs-5"><partial name="_Stars" model="avg" /></div>
                                <div class="small text-muted">@reviews.Count đánh giá</div>
                            </div>
                            <div class="col-sm-8">
                                @for (int star = 5; star >= 1; star--)
                                {
                                    var cnt = reviews.Count(r => r.Rating == star);
                                    var pct = reviews.Count > 0 ? cnt * 100 / reviews.Count : 0;
                                    <div class="d-flex align-items-center gap-2 small mb-1">
                                        <span class="text-muted" style="width: 28px;">@star <i class="bi bi-star-fill" style="color:#f59e0b;font-size:.7rem"></i></span>
                                        <div class="rating-bar flex-grow-1"><span style="width:@pct%"></span></div>
                                        <span class="text-muted text-end" style="width: 24px;">@cnt</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <hr class="my-3" />
                        @foreach (var r in reviews.Take(10))
                        {
                            var name = r.Customer?.FullName ?? "Người chơi";
                            var ini = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(w => char.ToUpper(w[0])));
                            <div class="review-item">
                                <div class="d-flex align-items-start gap-3">
                                    <span class="avatar">@ini</span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex flex-wrap justify-content-between gap-2">
                                            <div class="fw-semibold text-ink">@name</div>
                                            <div class="small text-muted">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                        </div>
                                        <div class="small mb-1"><partial name="_Stars" model="(double)r.Rating" /></div>
                                        @if (!string.IsNullOrWhiteSpace(r.Comment))
                                        {
                                            <div class="small">@r.Comment</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.OwnerReply))
                                        {
                                            <div class="owner-reply"><strong class="text-success"><i class="bi bi-reply me-1"></i>Chủ sân phản hồi:</strong> @r.OwnerReply</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="sticky-side">
                <div class="panel mb-4">
                    <div class="panel-body">
                        <h6 class="fw-bold text-ink mb-3"><i class="bi bi-calendar-check text-success me-2"></i>Đặt lịch nhanh</h6>
                        <div class="d-grid gap-2 mb-3">
                            @foreach (var c in activeCourts)
                            {
                                <a asp-action="Matrix" asp-route-courtId="@c.Id" class="btn btn-light d-flex justify-content-between align-items-center">
                                    <span>@c.Name</span><i class="bi bi-arrow-right"></i>
                                </a>
                            }
                            @if (!activeCourts.Any())
                            {
                                <div class="small text-muted">Hiện chưa có sân nào nhận đặt.</div>
                            }
                        </div>
                        <ul class="list-check small mb-3">
                            <li><i class="bi bi-check-circle-fill"></i> Giữ chỗ ngay sau khi thanh toán</li>
                            <li><i class="bi bi-check-circle-fill"></i> Hủy miễn phí trước giờ chơi ít nhất 6 tiếng</li>
                            <li><i class="bi bi-check-circle-fill"></i> Mang giày phù hợp mặt sân</li>
                        </ul>
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: var(--line-2);">
                            <span class="avatar">@((Model.Owner?.FullName ?? "C").Split(' ').Last()[0])</span>
                            <div class="min-w-0">
                                <div class="small text-muted">Chủ sân</div>
                                <div class="fw-semibold text-ink text-truncate">@(Model.Owner?.FullName ?? "Ban quản lý")</div>
                                <div class="small"><i class="bi bi-telephone me-1"></i>@(Model.Owner?.PhoneNumber ?? "1900 6868")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel overflow-hidden">
                    <div style="height: 240px;">
                        <iframe src="@mapEmbedUrl" width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Bản đồ"></iframe>
                    </div>
                    <div class="panel-body">
                        <div class="small mb-2"><i class="bi bi-pin-map text-danger me-1"></i>@Model.Address</div>
                        <a href="@mapDirectionUrl" target="_blank" rel="noopener noreferrer" class="btn btn-light btn-sm w-100"><i class="bi bi-sign-turn-right me-1"></i> Chỉ đường Google Maps</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
