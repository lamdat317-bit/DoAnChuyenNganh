@model DACN.Models.Facility
@{
    ViewData["Title"] = $"{Model.Name} - Chi tiết cụm sân thể thao";
    var coverImg = DACN.Services.FacilityService.GetSportCoverImage(Model.SportType?.Name);

    var hasCoordinates = Model.Latitude.HasValue && Model.Longitude.HasValue && Model.Latitude.Value != 0;
    var googleMapEmbedUrl = hasCoordinates 
        ? $"https://maps.google.com/maps?q={Model.Latitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{Model.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&hl=vi&z=16&output=embed"
        : $"https://maps.google.com/maps?q={Uri.EscapeDataString(Model.Name + ", " + Model.Address)}&hl=vi&z=16&output=embed";

    var googleMapDirectionUrl = hasCoordinates
        ? $"https://www.google.com/maps/dir/?api=1&destination={Model.Latitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{Model.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
        : $"https://www.google.com/maps/dir/?api=1&destination={Uri.EscapeDataString(Model.Address)}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Booking" asp-action="Index">Tìm & Đặt sân</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Facility Hero Header with Stadium Backdrop -->
    <div class="card border-0 shadow-lg text-white overflow-hidden mb-4" 
         style="background: linear-gradient(135deg, rgba(6, 78, 59, 0.92) 0%, rgba(15, 23, 42, 0.95) 50%, rgba(2, 132, 199, 0.92) 100%), url('@coverImg') center/cover no-repeat; border-radius: 16px;">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold fs-6">
                    <i class="@(Model.SportType?.IconCss ?? "bi bi-activity") me-1"></i> @(Model.SportType?.Name ?? "Thể thao")
                </span>
                <div class="d-flex gap-2">
                    <span class="badge bg-white bg-opacity-20 px-3 py-2 text-white">
                        <i class="bi bi-grid-3x3-gap-fill me-1"></i> @Model.Courts.Count sân thi đấu
                    </span>
                    <span class="badge bg-success px-3 py-2 text-white">
                        <i class="bi bi-check-circle-fill me-1"></i> Đang mở cửa
                    </span>
                </div>
            </div>

            <h1 class="display-6 fw-bold mb-2">@Model.Name</h1>
            <p class="lead text-white-50 mb-3 fs-6">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Address
            </p>

            <div class="d-flex flex-wrap gap-4 text-white-50 small pt-3 border-top border-white border-opacity-10">
                <div><i class="bi bi-clock-fill text-warning me-1"></i> <strong>Giờ hoạt động:</strong> @Model.OpeningTime.ToString(@"hh\:mm") - @Model.ClosingTime.ToString(@"hh\:mm")</div>
                <div><i class="bi bi-person-fill text-info me-1"></i> <strong>Chủ sân:</strong> @(Model.Owner?.FullName ?? "Ban Quản Lý Sân")</div>
                <div><i class="bi bi-telephone-fill text-success me-1"></i> <strong>Hotline đặt chỗ:</strong> @(Model.Owner?.PhoneNumber ?? "1900 8888")</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Courts List & Booking -->
        <div class="col-lg-8">
            <!-- Facility Description -->
            <div class="card border-0 shadow-sm mb-4 bg-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i> Giới Thiệu Cụm Sân & Tiêu Chuẩn
                    </h5>
                    <p class="text-secondary mb-3" style="line-height: 1.8;">
                        @(string.IsNullOrEmpty(Model.Description) 
                            ? "Cụm sân thể thao chất lượng cao, trang bị hệ thống chiếu sáng hiện đại, mặt sân đạt chuẩn thi đấu, bãi đỗ xe rộng rãi cùng đầy đủ tiện ích phụ trợ phục vụ người chơi tốt nhất." 
                            : Model.Description)
                    </p>

                    <!-- Amenities list -->
                    <div class="row g-2 mt-2">
                        <div class="col-6 col-md-4">
                            <div class="p-2 bg-light rounded text-muted small d-flex align-items-center gap-2">
                                <i class="bi bi-lightbulb-fill text-warning"></i> Đèn LED chuẩn thi đấu
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-2 bg-light rounded text-muted small d-flex align-items-center gap-2">
                                <i class="bi bi-p-square-fill text-primary"></i> Bãi giữ xe rộng rãi
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-2 bg-light rounded text-muted small d-flex align-items-center gap-2">
                                <i class="bi bi-cup-hot-fill text-danger"></i> Căng tin & Nước uống
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-2 bg-light rounded text-muted small d-flex align-items-center gap-2">
                                <i class="bi bi-wifi text-info"></i> Wifi tốc độ cao
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-2 bg-light rounded text-muted small d-flex align-items-center gap-2">
                                <i class="bi bi-droplet-fill text-success"></i> Phòng tắm & Thay đồ
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-2 bg-light rounded text-muted small d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check text-success"></i> Camera an ninh 24/7
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Google Maps & Direction Card (Bản đồ định vị sân & Chỉ đường) -->
            <div class="card border-0 shadow-lg mb-4 overflow-hidden" style="background: #0f172a; border: 1px solid rgba(0, 255, 170, 0.25) !important;">
                <div class="card-header py-3 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: rgba(16, 185, 129, 0.1); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <h5 class="fw-bold mb-0 text-white d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-danger fs-5" style="filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.7));"></i>
                        <span>Vị Trí Cụm Sân &amp; Bản Đồ Chỉ Đường</span>
                    </h5>
                    <a href="@googleMapDirectionUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sport-gradient btn-sm fw-bold px-3 rounded-pill shadow-sm">
                        <i class="bi bi-cursor-fill me-1"></i> Mở Google Maps chỉ đường
                    </a>
                </div>
                <div class="card-body p-0">
                    <!-- Google Maps Embed Frame -->
                    <div class="position-relative overflow-hidden" style="height: 320px; width: 100%;">
                        <iframe 
                            src="@googleMapEmbedUrl" 
                            width="100%" 
                            height="100%" 
                            style="border:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                    <div class="p-3 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: #090e1a; border-top: 1px solid rgba(255, 255, 255, 0.08);">
                        <div>
                            <div class="text-white small fw-bold">
                                <i class="bi bi-pin-map-fill text-danger me-1"></i> @Model.Address
                            </div>
                            @if (hasCoordinates)
                            {
                                <small class="text-white-50">Tọa độ GPS: @Model.Latitude!.Value.ToString("F4"), @Model.Longitude!.Value.ToString("F4")</small>
                            }
                        </div>
                        <a href="@googleMapDirectionUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info btn-sm rounded-pill px-3">
                            <i class="bi bi-sign-turn-right me-1"></i> Dẫn đường trực tiếp qua GPS
                        </a>
                    </div>
                </div>
            </div>

            <!-- List of Sub-Courts (Sân con) -->
            <div class="card border-0 shadow-sm mb-4 bg-white">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-grid-3x3-gap-fill text-success me-2"></i> Danh Sách Sân Con (@Model.Courts.Count sân)
                    </h5>
                    <small class="text-muted">Chọn sân để xem ma trận lịch trống</small>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        @foreach (var court in Model.Courts)
                        {
                            var slots = court.TimeSlots.ToList();
                            decimal minP = slots.Any() ? slots.Min(s => s.Price) : 150000m;
                            decimal maxP = slots.Any() ? slots.Max(s => s.Price) : 250000m;

                            <div class="col-md-6">
                                <div class="card h-100 border p-3 bg-light hover-scale">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="fw-bold text-dark mb-0">@court.Name</h5>
                                        <span class="badge @(court.IsActive ? "bg-success" : "bg-danger")">
                                            @(court.IsActive ? "Hoạt động" : "Bảo trì")
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-3">
                                        Mặt sân cao cấp, đạt chuẩn độ nảy và độ êm, bảo vệ cổ chân và khớp gối.
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                        <div>
                                            <small class="text-muted d-block">Giá từ:</small>
                                            <span class="text-danger fw-bold fs-6">@minP.ToString("N0") - @maxP.ToString("N0") đ</span>
                                            <small class="text-muted">/h</small>
                                        </div>
                                        @if (court.IsActive)
                                        {
                                            <a asp-action="Matrix" asp-route-courtId="@court.Id" class="btn btn-primary btn-sm fw-bold px-3">
                                                <i class="bi bi-calendar-event me-1"></i> Đặt sân
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled>Tạm ngưng</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Facility Services / Rental (Dịch vụ tiện ích) -->
            @if (Model.Services.Any())
            {
                <div class="card border-0 shadow-sm mb-4 bg-white">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-bag-check-fill text-warning me-2"></i> Bảng Giá Dịch Vụ & Thuê Đồ Tại Sân
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Tên dịch vụ / Phụ kiện</th>
                                        <th>Đơn vị</th>
                                        <th class="text-end pe-4">Đơn giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.Services.Where(x => x.IsActive))
                                    {
                                        <tr>
                                            <td class="ps-4 fw-semibold text-dark">
                                                <i class="bi bi-dot text-primary fs-4 me-1"></i> @s.Name
                                            </td>
                                            <td class="text-muted">@s.Unit</td>
                                            <td class="text-end pe-4 fw-bold text-danger">@s.Price.ToString("N0") VNĐ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Booking summary & Guidelines -->
        <div class="col-lg-4">
            <!-- Quick Action Card -->
            <div class="card border-0 shadow-sm mb-4 bg-white sticky-top" style="top: 80px; z-index: 10;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-calendar-check-fill text-primary me-2"></i> Đặt Lịch Thi Đấu Ngay
                    </h5>

                    <p class="text-muted small mb-3">
                        Chọn một trong các sân con của cơ sở để xem ngay ma trận các khung giờ còn trống hôm nay và đặt chỗ:
                    </p>

                    <div class="d-grid gap-2 mb-4">
                        @foreach (var c in Model.Courts.Where(x => x.IsActive))
                        {
                            <a asp-action="Matrix" asp-route-courtId="@c.Id" class="btn btn-outline-primary d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="fw-semibold">@c.Name</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3 small">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-shield-check text-success me-1"></i> Quy định đặt & giữ sân:</div>
                        <ul class="ps-3 mb-0 text-muted">
                            <li>Giữ chỗ ngay sau khi thanh toán thành công.</li>
                            <li>Được hủy và dời lịch trước giờ đá ít nhất 6 tiếng.</li>
                            <li>Vui lòng mang trang phục và giày thể thao phù hợp mặt sân.</li>
                        </ul>
                    </div>

                    <div class="d-grid">
                        <a href="tel:@(Model.Owner?.PhoneNumber ?? "19008888")" class="btn btn-outline-success">
                            <i class="bi bi-telephone-fill me-1"></i> Gọi hotline hỗ trợ: @(Model.Owner?.PhoneNumber ?? "1900 8888")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

