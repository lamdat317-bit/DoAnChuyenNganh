            <div class="toast app-toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex align-items-start gap-2 p-3">
                    <span class="icon-bubble sm green"><i class="bi bi-check-lg"></i></span>
                    <div class="flex-grow-1 small pt-1 text-ink">@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="toast" aria-label="Đóng"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast app-toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex align-items-start gap-2 p-3">
                    <span class="icon-bubble sm red"><i class="bi bi-exclamation-lg"></i></span>
                    <div class="flex-grow-1 small pt-1 text-ink">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="toast" aria-label="Đóng"></button>
                </div>
            </div>
        }
    </div>

