@using System.Security.Claims
@using DACN.Models.Enums
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SanBong.vn | Nền tảng thể thao trực tuyến</title>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Main Navigation Bar -->
    <header class="sticky-top py-2" style="background: rgba(3, 7, 18, 0.65); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="container">
            <nav class="navbar navbar-expand-lg cyber-navbar-container">
                <a class="navbar-brand d-flex align-items-center gap-2 me-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-ball-icon">
                        <i class="bi bi-dribbble"></i>
                    </span>
                    <span class="cyber-brand-text">SanBong<span class="dot-vn">.vn</span></span>
                </a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="cyber-nav-item active" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="cyber-nav-item" asp-area="" asp-controller="Booking" asp-action="Index">
                                <i class="bi bi-search"></i> Tìm &amp; Đặt sân
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="cyber-nav-item cyber-nav-hot" asp-area="" asp-controller="Teamwork" asp-action="Index">
                                <i class="bi bi-people-fill"></i> Ghép Đội &amp; Tìm Kèo 🔥
                                <span class="badge-flame-hot">HOT</span>
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item dropdown">
                            <a class="cyber-owner-btn dropdown-toggle d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-building-gear"></i> Kênh Chủ Sân
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border border-secondary border-opacity-25 mt-2" style="background: #0f172a;">
                                <li>
                                    <a class="dropdown-item text-white py-2" asp-area="Owner" asp-controller="Facility" asp-action="Index">
                                        <i class="bi bi-buildings me-2 text-info"></i> Danh sách cụm sân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-white py-2" asp-area="Owner" asp-controller="Facility" asp-action="CreateFacility">
                                        <i class="bi bi-plus-circle me-2 text-warning"></i> + Đăng ký cụm sân mới
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-white py-2" asp-area="Owner" asp-controller="Facility" asp-action="Bookings">
                                        <i class="bi bi-receipt me-2 text-success"></i> Quản lý đơn đặt sân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-white py-2" asp-area="Owner" asp-controller="Facility" asp-action="ScheduleBoard" asp-route-facilityId="1">
                                        <i class="bi bi-calendar3-range me-2 text-primary"></i> Bảng Lịch Đặt (Schedule Board)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                                <li>
                                    <a class="dropdown-item text-white py-2" asp-area="Admin" asp-controller="User" asp-action="Index">
                                        <i class="bi bi-shield-lock me-2 text-danger"></i> Quản trị Admin &amp; Cấp quyền Quản lý
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-white py-2" asp-area="Admin" asp-controller="Bank" asp-action="Index">
                                        <i class="bi bi-bank2 me-2 text-warning"></i> Quản trị Admin: Ngân Hàng Ảo (Sổ Cái)
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="cyber-user-pill dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                                    <span class="bg-primary text-white rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">
                                        <i class="bi bi-person-fill small"></i>
                                    </span>
                                    <span>@(User.Identity.Name?.Split('@')[0] ?? "customer")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border border-secondary border-opacity-25 mt-2" style="background: #0f172a;">
                                    <li>
                                        <a class="dropdown-item text-white py-2" asp-area="" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-badge me-2 text-primary"></i> Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-white py-2" asp-area="" asp-controller="Booking" asp-action="MyBookings">
                                            <i class="bi bi-ticket-perforated me-2 text-success"></i> Vé sân của tôi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-white py-2" asp-area="" asp-controller="Teamwork" asp-action="MyMatches">
                                            <i class="bi bi-people me-2 text-warning"></i> Kèo thể thao của tôi
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Account" asp-action="Login" class="cyber-nav-item">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-sport-gradient btn-sm px-3 rounded-pill">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <!-- Toast Notifications -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast show align-items-center text-bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast show align-items-center text-bg-danger border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <!-- Modern Footer -->
    <footer class="bg-dark text-white-50 py-5 mt-auto border-top border-secondary border-opacity-25">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-dribbble text-success"></i> SanBong<span class="text-success">.vn</span>
                    </h5>
                    <p class="small mb-3">
                        Nền tảng kết nối người chơi và quản lý dịch vụ đặt sân thể thao trực tuyến hàng đầu Việt Nam. Giải pháp toàn diện cho người đam mê thể thao và các chủ cơ sở kinh doanh sân bãi.
                    </p>
                    <div class="d-flex gap-3 text-white fs-5">
                        <a href="#" class="text-white-50 hover-primary"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white-50 hover-primary"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-white-50 hover-primary"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3">Môn Thể Thao</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-area="" asp-controller="Booking" asp-action="Index" class="text-white-50 text-decoration-none">Bóng đá mini</a></li>
                        <li><a asp-area="" asp-controller="Booking" asp-action="Index" class="text-white-50 text-decoration-none">Pickleball Pro</a></li>
                        <li><a asp-area="" asp-controller="Booking" asp-action="Index" class="text-white-50 text-decoration-none">Cầu lông thi đấu</a></li>
                        <li><a asp-area="" asp-controller="Booking" asp-action="Index" class="text-white-50 text-decoration-none">Quần vợt Tennis</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3">Tính Năng Chính</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-area="" asp-controller="Booking" asp-action="Index" class="text-white-50 text-decoration-none">Xem ma trận slot trống</a></li>
                        <li><a asp-area="" asp-controller="Teamwork" asp-action="Index" class="text-white-50 text-decoration-none">Tìm kèo ghép đội</a></li>
                        <li><a asp-area="Owner" asp-controller="Facility" asp-action="Index" class="text-white-50 text-decoration-none">Dành cho chủ sân</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Profile" class="text-white-50 text-decoration-none">Hồ sơ cá nhân</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="text-white fw-bold mb-3">Tiêu Chuẩn Công Nghệ Đồ Án</h6>
                    <p class="small mb-2"><i class="bi bi-cpu-fill text-warning me-2"></i> Kiến trúc: ASP.NET Core 8.0 N-Layer Repository Pattern</p>
                    <p class="small mb-2"><i class="bi bi-lock-fill text-success me-2"></i> Concurrency Control: Serializable Isolation & RowVersion</p>
                    <p class="small mb-0"><i class="bi bi-qr-code text-info me-2"></i> Thanh toán: VietQR NAPAS 247 Dynamic Generation</p>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4" />
            <div class="text-center small text-white-50">
                &copy; @DateTime.Now.Year - SanBong.vn • Đồ án chuyên ngành Công nghệ thông tin
            </div>
        </div>
    </footer>

    <!-- Floating AI Chat Launcher Button -->
    <div id="aiChatLauncher" class="ai-chat-launcher" onclick="toggleAiChat()">
        <span class="ai-pulse-dot"></span>
        <i class="bi bi-robot fs-5"></i>
        <span class="fw-bold small d-none d-sm-inline">SanBong AI</span>
    </div>

    <!-- Floating AI Chat Window -->
    <div id="aiChatWindow" class="ai-chat-window hidden">
        <!-- Header -->
        <div class="ai-chat-header">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(0, 255, 170, 0.2); border: 1px solid rgba(0, 255, 170, 0.5); color: #00ffaa;">
                    <i class="bi bi-robot"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">Trợ Lý AI SanBong.vn</h6>
                    <small style="font-size: 0.72rem; color: #a7f3d0;"><span class="ai-pulse-dot" style="width:6px;height:6px;"></span> Trực tuyến 24/7 • Hỏi đáp tức thì</small>
                </div>
            </div>
            <button type="button" class="btn btn-sm text-white-50 p-0 fs-5" onclick="toggleAiChat()" title="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Messages Body -->
        <div class="ai-chat-body" id="aiChatBody">
            <!-- Welcome Message -->
            <div class="ai-msg bot">
                <div class="ai-msg-bubble">
                    👋 <strong>Xin chào!</strong> Tôi là Trợ Lý Thể Thao AI của SanBong.vn. Tôi có thể hỗ trợ bạn:
                    <ul class="ps-3 my-2 small">
                        <li>Tra cứu sân bóng đá, pickleball, tennis, cầu lông</li>
                        <li>Kiểm tra khung giờ trống và đặt lịch giữ chỗ</li>
                        <li>Hướng dẫn thanh toán VietQR &amp; nhận vé QR</li>
                        <li>Hỗ trợ tìm kèo giao lưu và ghép đội</li>
                    </ul>
                    Bạn muốn tìm hiểu thông tin gì hôm nay?
                </div>
            </div>

            <!-- Quick Suggestions -->
            <div class="d-flex flex-wrap gap-1 my-1" id="aiSuggestionChips">
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Sân bóng đá nào gần đây?')">⚽ Sân bóng đá gần đây</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Có sân Pickleball không?')">🏓 Sân Pickleball</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Làm sao để đặt sân không trùng lịch?')">🛡️ Chống trùng lịch</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Cách thanh toán qua VietQR?')">💳 Thanh toán VietQR</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Chỉ đường Google Maps đến sân?')">📍 Chỉ đường Google Maps</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Làm sao để tìm kèo ghép đội?')">👥 Ghép đội &amp; tìm kèo</span>
            </div>
        </div>

        <!-- Input Footer -->
        <div class="ai-chat-footer">
            <input type="text" id="aiUserInput" class="ai-chat-input" placeholder="Hỏi AI về sân, giá, lịch, kèo..." onkeydown="handleAiInputKey(event)" />
            <button type="button" class="ai-chat-send" onclick="sendAiMessage()" title="Gửi câu hỏi">
                <i class="bi bi-send-fill" style="font-size: 0.85rem;"></i>
            </button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Auto-dismiss toasts after 4 seconds
        setTimeout(function() {
            var toasts = document.querySelectorAll('.toast');
            toasts.forEach(function(t) {
                var toastInstance = bootstrap.Toast.getInstance(t) || new bootstrap.Toast(t);
                toastInstance.hide();
            });
        }, 4000);

        // AI Chat Widget Logic
        function toggleAiChat() {
            var win = document.getElementById('aiChatWindow');
            if (win.classList.contains('hidden')) {
                win.classList.remove('hidden');
                document.getElementById('aiUserInput').focus();
            } else {
                win.classList.add('hidden');
            }
        }

        function handleAiInputKey(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendAiMessage();
            }
        }

        function askAiQuestion(text) {
            document.getElementById('aiUserInput').value = text;
            sendAiMessage();
        }

        async function sendAiMessage() {
            var input = document.getElementById('aiUserInput');
            var message = input.value.trim();
            if (!message) return;

            var chatBody = document.getElementById('aiChatBody');

            // Render User message
            var userMsg = document.createElement('div');
            userMsg.className = 'ai-msg user';
            userMsg.innerHTML = '<div class="ai-msg-bubble">' + escapeHtml(message) + '</div>';
            chatBody.appendChild(userMsg);
            input.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;

            // Render typing indicator
            var typingMsg = document.createElement('div');
            typingMsg.className = 'ai-msg bot typing-msg';
            typingMsg.innerHTML = '<div class="ai-msg-bubble text-white-50"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span> SanBong AI đang suy nghĩ...</div>';
            chatBody.appendChild(typingMsg);
            chatBody.scrollTop = chatBody.scrollHeight;

            try {
                const response = await fetch('/api/ai/ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });

                const data = await response.json();
                chatBody.removeChild(typingMsg);

                var botMsg = document.createElement('div');
                botMsg.className = 'ai-msg bot';
                
                var formattedReply = formatAiReply(data.reply);
                var actionHtml = '';
                if (data.actionUrl && data.actionText) {
                    actionHtml = '<div class="mt-2 pt-2 border-top border-secondary border-opacity-25">' +
                                 '<a href="' + data.actionUrl + '" class="btn btn-sport-gradient btn-sm py-1 px-3 rounded-pill text-white fw-bold" style="font-size:0.8rem;">' +
                                 '<i class="bi bi-box-arrow-up-right me-1"></i> ' + data.actionText + '</a></div>';
                }

                botMsg.innerHTML = '<div class="ai-msg-bubble">' + formattedReply + actionHtml + '</div>';
                chatBody.appendChild(botMsg);

                // Update dynamic suggestion chips
                if (data.quickSuggestions && data.quickSuggestions.length > 0) {
                    var chipsContainer = document.getElementById('aiSuggestionChips');
                    if (chipsContainer) {
                        chipsContainer.innerHTML = '';
                        data.quickSuggestions.forEach(function(sugg) {
                            var chip = document.createElement('span');
                            chip.className = 'ai-suggestion-chip';
                            chip.textContent = sugg;
                            chip.onclick = function() { askAiQuestion(sugg); };
                            chipsContainer.appendChild(chip);
                        });
                    }
                }

                chatBody.scrollTop = chatBody.scrollHeight;
            } catch (err) {
                chatBody.removeChild(typingMsg);
                var errEl = document.createElement('div');
                errEl.className = 'ai-msg bot';
                errEl.innerHTML = '<div class="ai-msg-bubble text-danger small"><i class="bi bi-exclamation-circle me-1"></i> Không thể kết nối với dịch vụ AI. Vui lòng thử lại sau!</div>';
                chatBody.appendChild(errEl);
                chatBody.scrollTop = chatBody.scrollHeight;
            }
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function formatAiReply(text) {
            if (!text) return '';
            var formatted = escapeHtml(text);
            formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            formatted = formatted.replace(/\*(.*?)\*/g, '<em>$1</em>');
            formatted = formatted.replace(/\n/g, '<br/>');
            return formatted;
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
