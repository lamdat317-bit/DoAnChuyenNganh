@using System.Security.Claims
@using DACN.Services
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isOwner = User.IsInRole(AppRoles.Owner);
    var fullName = User.FindFirst("FullName")?.Value;
    if (string.IsNullOrWhiteSpace(fullName)) { fullName = User.Identity?.Name?.Split('@')[0] ?? "Tài khoản"; }
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(w => char.ToUpper(w[0])));
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(bool cond) => cond ? "active" : "";
}
