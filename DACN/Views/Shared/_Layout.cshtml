            <div class="d-flex flex-wrap gap-1 my-1" id="aiSuggestionChips">
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Sân bóng đá nào gần đây?')">⚽ Sân bóng đá</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Có sân Pickleball không?')">🏓 Pickleball</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Làm sao để đặt sân không trùng lịch?')">🛡️ Chống trùng lịch</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Cách thanh toán qua VietQR?')">💳 Thanh toán VietQR</span>
                <span class="ai-suggestion-chip" onclick="askAiQuestion('Làm sao để tìm kèo ghép đội?')">👥 Ghép đội</span>
            </div>
        </div>

        <div class="ai-chat-footer">
            <input type="text" id="aiUserInput" class="ai-chat-input" placeholder="Hỏi về sân, giá, lịch, kèo..." onkeydown="handleAiInputKey(event)" />
            <button type="button" class="ai-chat-send" onclick="sendAiMessage()" title="Gửi"><i class="bi bi-send-fill" style="font-size:.85rem;"></i></button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap5/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        setTimeout(function () {
            document.querySelectorAll('.toast').forEach(function (t) {
                (bootstrap.Toast.getInstance(t) || new bootstrap.Toast(t)).hide();
            });
        }, 5000);

        function toggleAiChat() {
            var win = document.getElementById('aiChatWindow');
            win.classList.toggle('hidden');
            if (!win.classList.contains('hidden')) document.getElementById('aiUserInput').focus();
        }
        function handleAiInputKey(e) { if (e.key === 'Enter') { e.preventDefault(); sendAiMessage(); } }
        function askAiQuestion(text) { document.getElementById('aiUserInput').value = text; sendAiMessage(); }

        async function sendAiMessage() {
            var input = document.getElementById('aiUserInput');
            var message = input.value.trim();
            if (!message) return;
            var chatBody = document.getElementById('aiChatBody');

            var userMsg = document.createElement('div');
            userMsg.className = 'ai-msg user';
            userMsg.innerHTML = '<div class="ai-msg-bubble">' + escapeHtml(message) + '</div>';
            chatBody.appendChild(userMsg);
            input.value = '';

            var typingMsg = document.createElement('div');
            typingMsg.className = 'ai-msg bot';
            typingMsg.innerHTML = '<div class="ai-msg-bubble text-muted"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div>';
            chatBody.appendChild(typingMsg);
            chatBody.scrollTop = chatBody.scrollHeight;

            try {
                const response = await fetch('/api/ai/ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                const data = await response.json();
                chatBody.removeChild(typingMsg);

                var botMsg = document.createElement('div');
                botMsg.className = 'ai-msg bot';
                var actionHtml = '';
                if (data.actionUrl && data.actionText) {
                    actionHtml = '<div class="mt-2 pt-2 border-top"><a href="' + data.actionUrl + '" class="btn btn-primary btn-sm">' +
                        '<i class="bi bi-arrow-right-circle me-1"></i>' + escapeHtml(data.actionText) + '</a></div>';
                }
                botMsg.innerHTML = '<div class="ai-msg-bubble">' + formatAiReply(data.reply) + actionHtml + '</div>';
                chatBody.appendChild(botMsg);

                if (data.quickSuggestions && data.quickSuggestions.length > 0) {
                    var chips = document.getElementById('aiSuggestionChips');
                    if (chips) {
                        chips.innerHTML = '';
                        data.quickSuggestions.forEach(function (s) {
                            var chip = document.createElement('span');
                            chip.className = 'ai-suggestion-chip';
                            chip.textContent = s;
                            chip.onclick = function () { askAiQuestion(s); };
                            chips.appendChild(chip);
                        });
                        chatBody.appendChild(chips);
                    }
                }
                chatBody.scrollTop = chatBody.scrollHeight;
            } catch (err) {
                chatBody.removeChild(typingMsg);
                var errEl = document.createElement('div');
                errEl.className = 'ai-msg bot';
                errEl.innerHTML = '<div class="ai-msg-bubble text-danger small"><i class="bi bi-exclamation-circle me-1"></i> Không kết nối được trợ lý. Vui lòng thử lại.</div>';
                chatBody.appendChild(errEl);
                chatBody.scrollTop = chatBody.scrollHeight;
            }
        }
        function escapeHtml(text) { var d = document.createElement('div'); d.textContent = text; return d.innerHTML; }
        function formatAiReply(text) {
            if (!text) return '';
            return escapeHtml(text)
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/\n/g, '<br/>');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
