@model DACN.Models.ViewModels.FacilityCardDto
<div class="card venue-card card-hover">
    <a asp-area="" asp-controller="Booking" asp-action="FacilityDetail" asp-route-id="@Model.Id" class="cover d-block">
        <img src="@(Model.ImageUrl ?? "https://images.unsplash.com/photo-1529900748604-07564a03e7a6?auto=format&fit=crop&w=800&q=70")" alt="@Model.Name" loading="lazy" />
        <div class="tags">
            <span class="glass-tag"><i class="@(Model.IconCss ?? "bi bi-tag") text-success"></i> @Model.SportTypeName</span>
            @if (Model.ReviewCount > 0)
            {
                <span class="glass-tag"><i class="bi bi-star-fill" style="color:#f59e0b"></i> @Model.AverageRating.ToString("0.0")</span>
            }
        </div>
    </a>
    <div class="body">
        <div class="title"><a asp-area="" asp-controller="Booking" asp-action="FacilityDetail" asp-route-id="@Model.Id">@Model.Name</a></div>
        <div class="addr text-truncate" title="@Model.Address"><i class="bi bi-geo-alt me-1"></i>@Model.Address</div>
        <div class="meta">
            <span><i class="bi bi-grid-3x3-gap"></i> @Model.CourtCount sân</span>
            <span><i class="bi bi-clock"></i> @Model.OpeningHours</span>
            @if (Model.ReviewCount > 0)
            {
                <span><i class="bi bi-chat-square-text"></i> @Model.ReviewCount đánh giá</span>
            }
            else
            {
                <span><i class="bi bi-stars"></i> Sân mới</span>
            }
        </div>
        <div class="foot">
            <div class="price">@Model.MinPrice.ToString("N0")đ<small>/giờ</small></div>
            @if (Model.FirstCourtId > 0)
            {
                <a asp-area="" asp-controller="Booking" asp-action="Matrix" asp-route-courtId="@Model.FirstCourtId" class="btn btn-primary btn-sm"><i class="bi bi-calendar-check me-1"></i>Đặt sân</a>
            }
            else
            {
                <span class="badge-soft neutral">Tạm ngưng</span>
            }
        </div>
    </div>
</div>
