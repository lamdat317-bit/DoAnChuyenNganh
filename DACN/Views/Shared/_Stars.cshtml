@model double
@{
    var rounded = Math.Round(Model * 2, MidpointRounding.AwayFromZero) / 2;
}
<span class="stars" title="@Model.ToString("0.0") / 5">
    @for (int i = 1; i <= 5; i++)
    {
        if (rounded >= i)
        {
            <i class="bi bi-star-fill"></i>
        }
        else if (rounded >= i - 0.5)
        {
            <i class="bi bi-star-half"></i>
        }
        else
        {
            <i class="bi bi-star-fill off"></i>
        }
    }
</span>
