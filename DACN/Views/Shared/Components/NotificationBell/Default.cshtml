@model List<DACN.Models.Notification>
@{
    int unread = ViewBag.Unread ?? 0;
    string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        if (d.TotalMinutes < 1) return "vừa xong";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes} phút trước";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours} giờ trước";
        return utc.ToLocalTime().ToString("dd/MM HH:mm");
    }
}
<div class="dropdown">
    <a class="notif-bell" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Thông báo (@unread chưa đọc)">
        <i class="bi bi-bell"></i>
        <span class="notif-count @(unread == 0 ? "d-none" : "")" id="notifCount">@(unread > 9 ? "9+" : unread.ToString())</span>
    </a>
    <div class="dropdown-menu dropdown-menu-end notif-menu p-0 mt-2">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <span class="fw-bold text-ink">Thông báo</span>
            @if (unread > 0)
            {
                <form asp-area="" asp-controller="Notifications" asp-action="MarkAllRead" method="post" class="m-0">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none">Đánh dấu đã đọc</button>
                </form>
            }
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted small py-4 px-3"><i class="bi bi-bell-slash fs-4 d-block mb-1"></i>Chưa có thông báo nào</div>
        }
        else
        {
            <div class="notif-list">
                @foreach (var n in Model)
                {
                    <a class="notif-item @(n.IsRead ? "" : "unread")" asp-area="" asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id">
                        <span class="icon-bubble sm @n.Tone"><i class="bi @n.Icon"></i></span>
                        <span class="min-w-0 flex-grow-1">
                            <span class="d-block fw-semibold text-ink small">@n.Title</span>
                            @if (!string.IsNullOrEmpty(n.Message))
                            {
                                <span class="d-block text-muted small notif-msg">@n.Message</span>
                            }
                            <span class="d-block text-muted" style="font-size:.72rem">@Ago(n.CreatedAt)</span>
                        </span>
                    </a>
                }
            </div>
        }
        <a class="d-block text-center small py-2 border-top text-decoration-none" asp-area="" asp-controller="Notifications" asp-action="Index">Xem tất cả</a>
    </div>
</div>
