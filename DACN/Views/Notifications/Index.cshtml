@model List<DACN.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
    var unread = Model.Count(n => !n.IsRead);
}

<div class="page-header">
    <div class="container" style="max-width: 820px;">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <h1>Thông báo</h1>
                <p class="sub">Cập nhật về đơn đặt sân, thanh toán, hoàn tiền và kèo ghép đội của bạn.</p>
            </div>
            @if (unread > 0)
            {
                <form asp-action="MarkAllRead" method="post" class="m-0">
                    <button type="submit" class="btn btn-light"><i class="bi bi-check2-all me-1"></i>Đánh dấu tất cả đã đọc (@unread)</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="container" style="max-width: 820px;">
    @if (!Model.Any())
    {
        <div class="panel empty-state">
            <span class="icon-bubble lg slate"><i class="bi bi-bell-slash"></i></span>
            <h5>Chưa có thông báo nào</h5>
            <p>Khi có đơn mới, thanh toán được xác nhận hay sắp tới giờ chơi, bạn sẽ thấy ở đây.</p>
        </div>
    }
    else
    {
        <div class="panel overflow-hidden">
            @foreach (var n in Model)
            {
                <a class="notif-item @(n.IsRead ? "" : "unread") border-bottom" asp-action="Open" asp-route-id="@n.Id">
                    <span class="icon-bubble @n.Tone"><i class="bi @n.Icon"></i></span>
                    <span class="min-w-0 flex-grow-1">
                        <span class="d-flex justify-content-between gap-2">
                            <span class="fw-semibold text-ink">@n.Title</span>
                            <span class="small text-muted text-nowrap">@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </span>
                        @if (!string.IsNullOrEmpty(n.Message))
                        {
                            <span class="d-block text-muted small mt-1">@n.Message</span>
                        }
                    </span>
                </a>
            }
        </div>
    }
</div>
